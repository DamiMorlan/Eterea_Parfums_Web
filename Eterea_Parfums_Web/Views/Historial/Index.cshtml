<style>


    :root {
        --rosa-claro: rgb(235, 199, 206);
        --rosa-medio: rgb(228, 137, 164);
        --rosa-fondo: rgb(249, 230, 225);
        --rosa-profundo: rgb(209, 167, 180);
        --rosa-suave: rgb(250, 236, 239);
        --beige: #f5f5dc;
        --moka: #b89b82;
    }

    body {
        background: var(--rosa-suave);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    h2 {
        color: var(--rosa-profundo);
    }

    .personal-data-container {
        border-radius: 2px;
        padding: 20px;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
        margin-bottom: 30px;
        font-family: 'Segoe UI', sans-serif;
    }

        .personal-data-container h3 {
            margin-top: 0;
            border-bottom: 1px solid #e0bfc7;
            padding-bottom: 5px;
            margin-bottom: 15px;
        }

        .personal-data-container p {
            margin: 5px 0;
            font-size: 16px;
        }

    .factura-card {
        background-color: white;
        border: 1px solid var(--rosa-profundo);
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 10px;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
        transition: box-shadow 0.3s, transform 0.2s;
    }

        .factura-card:hover {
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.2);
            transform: translateY(-1px);
        }

        .factura-card .card-title {
            color: var(--rosa-profundo);
            font-weight: bold;
            font-size: 1.2rem;
            margin-bottom: 10px;
        }

        .factura-card p {
            color: var(--rosa-medio);
            margin: 4px 0;
            color: #333;
        }

        .factura-card .btn-primary {
            background-color: var(--rosa-medio);
            border: none;
            font-weight: bold;
        }

            .factura-card .btn-primary:hover {
                background-color: var(--rosa-profundo);
            }

    .text-right {
        text-align: right;
    }

    .pagination {
        display: flex;
        list-style: none;
        padding-left: 0;
        border-radius: 0.25rem;
        justify-content: center;
        margin-top: 20px;
        margin-bottom: 20px;
    }

        .pagination .page-item {
            margin: 0 5px;
        }

        .pagination .page-link {
            color: var(--rosa-profundo);
            background-color: white;
            border: 1px solid var(--rosa-medio);
            padding: 8px 14px;
            border-radius: 6px;
            cursor: pointer;
            text-decoration: none;
            font-weight: 600;
            transition: background-color 0.3s, color 0.3s;
        }

            .pagination .page-link:hover {
                background-color: var(--rosa-medio);
                color: white;
                text-decoration: none;
            }

        .pagination .page-item.active .page-link {
            background-color: var(--rosa-profundo);
            color: white;
            border-color: var(--rosa-profundo);
            cursor: default;
        }

        .pagination .page-item.disabled .page-link {
            color: #ccc;
            pointer-events: none;
            background-color: #f8f8f8;
            border-color: #ddd;
            cursor: default;
        }

    .no-historial-container {
        text-align: center;
        margin: 4rem 0;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

        .no-historial-container svg {
            width: 80px;
            height: 80px;
            fill: var(--rosa-profundo);
            margin-bottom: 1.5rem;
        }

        .no-historial-container h3 {
            color: var(--rosa-profundo);
            margin-bottom: 1rem;
            font-weight: 600;
        }

        .no-historial-container p {
            color: var(--rosa-medio);
            font-size: 1.1rem;
            margin-bottom: 2rem;
        }

        .no-historial-container .btn-primary {
            background-color: var(--rosa-medio);
            border: none;
            font-size: 1.25rem;
            padding: 0.75rem 2.5rem;
            font-weight: 600;
            transition: background-color 0.3s ease;
        }

            .no-historial-container .btn-primary:hover {
                background-color: var(--rosa-profundo);
                color: white;
            }

        .no-historial-container img {
            width: 100%;
            height: auto;
            max-width: 200px; 
            display: block;
            margin: 0 auto 15px auto;
        }
</style>


@model Eterea_Parfums_Web.ViewModels.HistorialViewModel
@{
    ViewBag.Title = "Historial de compras";
}
@if (Model != null && Model.Facturas != null && Model.Facturas.Count > 0)
{
    <h2>@ViewBag.Title </h2>
    <hr class="separator">
    <div class="personal-data-container">
        <h3> Usuario</h3>
        <p> <strong> Nombre:</strong> @Model.Nombre </p>
        <p> <strong> Apellido:</strong> @Model.Apellido </p>
        <p> <strong> DNI:</strong> @Model.Dni </p>
        <p> <strong> Email:</strong> @Model.Email </p>
    </div>

    <hr class="separator">

    <div class="row">
        @foreach (var factura in Model.Facturas)
        {
            using (Html.BeginForm("DetalleFactura", "Historial", FormMethod.Post, new { @class = "factura-form" }))
            {
                <input type="hidden" name="factura_id" value="@factura.id" />
                <div class="factura-card clickable-card" onclick="this.closest('form').submit();">
                    <h5 class="card-title">Factura N° @factura.num_factura</h5>
                    <hr class="separator">
                    <p><strong>Fecha:</strong> @factura.fecha.ToString("dd/MM/yyyy")</p>
                    <p><strong>Total:</strong> $@factura.precio_total.ToString("N2")</p>

                    <div class="text-right">
                        <button type="submit" class="btn btn-primary">Ver Detalles</button>
                    </div>
                </div>
            }
        }
        @if (Model.TotalPaginas > 1)
        {
            <nav aria-label="Page navigation example">
                <ul class="pagination justify-content-center">

                    <li class="page-item @(Model.PaginaActual == 1 ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", "Historial", new { page = Model.PaginaActual - 1 })">Anterior</a>
                    </li>

                    @for (int i = 1; i <= Model.TotalPaginas; i++)
                    {
                        <li class="page-item @(Model.PaginaActual == i ? "active" : "")">
                            <a class="page-link" href="@Url.Action("Index", "Historial", new { page = i })">@i</a>
                        </li>
                    }

                    <li class="page-item @(Model.PaginaActual == Model.TotalPaginas ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", "Historial", new { page = Model.PaginaActual + 1 })">Siguiente</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
    <hr class="separator">
}
else
{
    <div class="no-historial-container">
        <img src="@Url.Content("~/imagenes/carro-vacio.png")" alt="Carro vacío" />
        <h3>No se encontraron compras en tu historial.</h3>
        <p>Parece que todavía no has realizado ninguna compra. ¡Explora nuestros perfumes y encuentra tu favorito!</p>
        <a href="@Url.Action("Index", "Perfume")" class="btn btn-primary">Ir a Perfumes</a>
    </div>

}

