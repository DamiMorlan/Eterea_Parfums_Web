
@{
    ViewBag.Title = "Detalle de la Factura N° " + ViewBag.NumeroFactura; // Agregar el número de factura al título
}

<h2>@ViewBag.Title</h2>

<hr class="separator">

@if (Model != null && Model.Count > 0)
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Foto del Perfume</th> <!-- Nueva columna para la foto del perfume -->
                <th>Nombre del Perfume</th>
                <th>Cantidad</th>
                <th>Descuento</th>
                <th>Precio Unitario</th>
                <th>Subtotal</th>

            </tr>
        </thead>
        <tbody>
            @foreach (var detalle in Model)
            {
                var perfume = detalle.Perfume; // Cargar el Perfume antes de cerrar el contexto de la base de datos
                var perfumeNombre = detalle.Perfume.ToString().Split('.')[1];
                <tr>
                    <td>
                        @if (perfume != null)
                        {
                            <img src="@Url.Content("~/Content/ImgPerfumes/ImgCh/" + perfume.imagen1 + ".jpg")" alt="@perfume.nombre" class="centrado" />
                        }
                        else
                        {
                            <span>Perfume no encontrado</span>
                        }
                    </td>
                    <td>
                        @if (perfume != null)
                        {
                            @perfume.nombre
                        }
                        else
                        {
                            <span>Perfume no encontrado</span>
                        }
                    </td>
                    <td>@detalle.cantidad</td>
                    <td>$ @detalle.precio_unitario</td>
                    <td>
                        <button class="btn btn-primary volver-comprar" data-perfume-nombre="@perfume.nombre" data-genero="@perfume.genero">Volver a comprar</button>

                    </td>
                </tr>
            }
        </tbody>
    </table>
    <hr class="separator">
}
else
{
    <p>No hay detalles disponibles para esta factura.</p>
}

@section scripts {
    <script>
        $(document).ready(function () {
            $('.volver-comprar').click(function () {
                var nombrePerfume = $(this).data('perfume-nombre');
                var genero = $(this).data('genero');
                window.location.href = '@Url.Action("Index", "Perfume", new { searchTerm = "" })' + '?searchTerm=' + encodeURIComponent(nombrePerfume);
            });
        });
    </script>
}
