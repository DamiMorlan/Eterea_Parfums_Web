
@model DetalleFacturaViewModel

@{
    ViewBag.Title = "Detalle de la factura";  
}

@section Styles {
    <link href="~/Content/StyleDetalleFactura.css" rel="stylesheet" type="text/css" />
}

<div class="container mt-4">
    <div class="factura-detalle-container">
        <h2>
            Detalle de la Factura N° @Model.NumeroFactura
        </h2>
        <h3 class="small-heading"><strong>Fecha:</strong> @Model.Fecha.ToString("dd/MM/yyyy")</h3>
        <hr class="separator" />

        @if (Model.Perfumes != null && Model.Perfumes.Count > 0)
        {
            foreach (var perfume in Model.Perfumes)
            {
                using (Html.BeginForm("Details", "Perfume", FormMethod.Post, new { @class = "Perfume-form" }))
                {
                    <div class="detalle-perfume-card" style="cursor:pointer;" onclick="this.closest('form').submit();">
                        <div class="row">
                            <div class="col-md-2">
                                <img src="@Url.Content("~/Imagenes/" + perfume.Imagen1 + ".jpg")" class="img-fluid" />
                            </div>
                            <div class="col-md-8">
                                <h5>@perfume.Nombre</h5>
                                <p><strong>Marca:</strong> @perfume.Marca</p>
                                <p><strong>Tamaño:</strong> @perfume.Tamaño ml</p>
                                <p><strong>Cantidad:</strong> @perfume.Cantidad</p>
                                <p><strong>Precio Unitario:</strong> $@perfume.PrecioUnitario</p>
                                <p><strong>Promoción:</strong> @perfume.Promocion</p>
                                <p><strong>Precio Total:</strong> $@perfume.PrecioTotal.ToString("N2")</p>

                            </div>
                            <div class="col-md-2">
                                <input type="hidden" name="id" value="@perfume.Id" />
                                <div class="text-right">
                                    <button type="submit" class="btn btn-primary mt-2">Volver a comprar</button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }

            if (Model.RecargoTarjeta > 0)
            {
                <div class="factura-recargo">
                    Recargo por pago con @Model.FormaDePago: $@Model.RecargoTarjeta.ToString("N2")
                </div>
            }

            <div class="factura-total">
                Precio Total: $@Model.PrecioTotal.ToString("N2")
            </div>
        }
        else
        {
            <p>No se encontraron perfumes en esta factura.</p>
        }
    </div>
</div>
<div class="text-center">
    <a href="@Url.Action("Index", "Historial")" class="btn-secondary">Volver al historial</a>
</div>


@section scripts {
    <script>
        $(document).ready(function () {
            $('.volver-comprar').click(function () {
                var nombrePerfume = $(this).data('perfume-nombre');
                var genero = $(this).data('genero');
                window.location.href = '@Url.Action("Index", "Perfume", new { searchTerm = "" })' + '?searchTerm=' + encodeURIComponent(nombrePerfume);
            });
        });
    </script>
}
