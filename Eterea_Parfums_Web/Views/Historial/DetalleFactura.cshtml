        --rosa-suave: rgb(250, 236, 239);
        --beige: #f5f5dc;
        --moka: #b89b82;
    }

    body {
        background: var(--rosa-suave);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    h2 {
        margin-bottom: 10px;
    }

    .small-heading {
        font-size: 1.5rem;
    }

