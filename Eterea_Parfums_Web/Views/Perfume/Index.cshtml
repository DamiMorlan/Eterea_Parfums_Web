@{
    ViewBag.Title = "Perfumes";
}

<div class="container mt-4">
    <div class="row">
        <!-- Filtros -->
        <aside class="col-md-3 mb-4">
            <h5 class="mb-3">Filtros</h5>

            <div class="mb-3">
                <label class="form-label">Marca</label>
                <select class="form-select">
                    <option>Todas</option>
                    <option>Chanel</option>
                    <option>Dior</option>
                    <option>Givenchy</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Género</label>
                <select class="form-select">
                    <option>Todos</option>
                    <option>Femenino</option>
                    <option>Masculino</option>
                    <option>Unisex</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Tamaño</label>
                <select class="form-select">
                    <option>Todos</option>
                    <option>30 ml</option>
                    <option>50 ml</option>
                    <option>100 ml</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Aroma</label>
                <select class="form-select">
                    <option>Todos</option>
                    <option>Floral</option>
                    <option>Frutal</option>
                    <option>Amaderado</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Tipo de aroma</label>
                <select class="form-select">
                    <option>Todos</option>
                    <option>Dulce</option>
                    <option>Fresco</option>
                    <option>Intenso</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Precio</label>
                <select class="form-select">
                    <option>Todos</option>
                    <option>Hasta $10.000</option>
                    <option>$10.000 - $30.000</option>
                    <option>Más de $30.000</option>
                </select>
            </div>
        </aside>

        <!-- Productos -->
        <section class="col-md-9">
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
                @* Simulamos 12 perfumes *@
                @for (int i = 1; i <= 12; i++)
                {
                    <div class="col">
                        <div class="card h-100">
                            <img src="~/Content/Images/@(i).jpg" class="card-img-top" alt="Perfume @i" style="height: 250px; object-fit: cover;">
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">Perfume @i</h5>
                                <p class="card-text mb-1">Marca: Dior</p>
                                <p class="card-text mb-1">Género: Femenino</p>
                                <p class="card-text mb-1">Tamaño: 100 ml</p>
                                <p class="card-text fw-bold mt-auto">$15.000</p>

                                <div class="d-flex flex-column mt-3">
                                    <button class="btn btn-eterea mb-2">
                                        <i class="fas fa-eye"></i> Ver
                                    </button>
                                    <button class="btn btn-eterea">
                                        <i class="fas fa-cart-plus"></i> Agregar al carrito
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Paginación -->
            <nav class="mt-5">
                <ul class="pagination justify-content-center">
                    <li class="page-item disabled">
                        <a class="page-link">Anterior</a>
                    </li>
                    <li class="page-item active">
                        <a class="page-link" href="#">1</a>
                    </li>
                    <li class="page-item">
                        <a class="page-link" href="#">2</a>
                    </li>
                    <li class="page-item">
                        <a class="page-link" href="#">3</a>
                    </li>
                    <li class="page-item">
                        <a class="page-link" href="#">Siguiente</a>
                    </li>
                </ul>
            </nav>
        </section>
    </div>
</div>

<style>
    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: rgb(249, 230, 225);
    }

    .btn-eterea {
        background-color: rgb(209, 167, 180);
        color: white;
        width: 100%;
        border: none;
        transition: background-color 0.3s ease;
    }

        .btn-eterea:hover {
            background-color: rgb(189, 147, 160);
        }

    .card-title {
        font-size: 1.1rem;
        font-weight: bold;
    }

    .pagination .page-link {
        color: rgb(209, 167, 180);
    }

    .pagination .page-item.active .page-link {
        background-color: rgb(209, 167, 180);
        border-color: rgb(209, 167, 180);
        color: white;
    }
</style>
