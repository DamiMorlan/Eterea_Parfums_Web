@model List<Eterea_Parfums_Web.Models.perfume>

@{
    ViewBag.Title = "Perfumes";
}

<div class="container mt-4">
    <div class="row">
        <!-- Filtros -->
        <aside class="col-md-3 mb-4">
            <h5 class="mb-3">Filtros</h5>

            <div class="mb-3">
                <label class="form-label">Marca</label>
                <select class="form-select">
                    <option>Todas</option>
                    <option>Chanel</option>
                    <option>Dior</option>
                    <option>Givenchy</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Género</label>
                <select class="form-select">
                    <option>Todos</option>
                    <option>Femenino</option>
                    <option>Masculino</option>
                    <option>Unisex</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Tamaño</label>
                <select class="form-select">
                    <option>Todos</option>
                    <option>30 ml</option>
                    <option>50 ml</option>
                    <option>100 ml</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Aroma</label>
                <select class="form-select">
                    <option>Todos</option>
                    <option>Floral</option>
                    <option>Frutal</option>
                    <option>Amaderado</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Tipo de aroma</label>
                <select class="form-select">
                    <option>Todos</option>
                    <option>Dulce</option>
                    <option>Fresco</option>
                    <option>Intenso</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Precio</label>
                <select class="form-select">
                    <option>Todos</option>
                    <option>Hasta $10.000</option>
                    <option>$10.000 - $30.000</option>
                    <option>Más de $30.000</option>
                </select>
            </div>
        </aside>

        <!-- Productos -->
        <section class="col-md-9">
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
                @foreach (var perfume in Model)
                {
                    <div class="col">
                        <div class="card perfume-card h-100">
                            <img src="@Url.Content("~/Imagenes/" + perfume.imagen1 + ".jpg")" class="card-img-top custom-img" alt="@perfume.nombre" />
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">@perfume.nombre</h5>
                                <p class="card-text mb-1">Marca: @perfume.marca.nombre</p>
                                <p class="card-text mb-1">Tamaño: @perfume.presentacion_ml ml</p>
                                <p class="card-text fw-bold mt-auto">$@perfume.precio_en_pesos</p>

                                <div class="d-flex flex-column mt-3">
                                    <button class="btn btn-eterea mb-2">
                                        <i class="fas fa-eye"></i> Ver
                                    </button>
                                    <button class="btn btn-eterea">
                                        <i class="fas fa-cart-plus"></i> Agregar al carrito
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Paginación -->
            <nav class="mt-5">
                <ul class="pagination justify-content-center">
                    <li class="page-item disabled">
                        <a class="page-link">Anterior</a>
                    </li>
                    <li class="page-item active">
                        <a class="page-link" href="#">1</a>
                    </li>
                    <li class="page-item">
                        <a class="page-link" href="#">2</a>
                    </li>
                    <li class="page-item">
                        <a class="page-link" href="#">3</a>
                    </li>
                    <li class="page-item">
                        <a class="page-link" href="#">Siguiente</a>
                    </li>
                </ul>
            </nav>
        </section>
    </div>
</div>

<style>
    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: rgb(249, 230, 225);
    }

    .card {
        border: none;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        display: flex;
        flex-direction: column;
        cursor: pointer;
    }

        .card:hover {
            box-shadow: 0 12px 24px rgba(0, 0, 0, 0.25);
            transform: translateY(-6px);
        }

    .card-title {
        font-size: 1.2rem;
        font-weight: bold;
    }

    .custom-img {
        height: 140px; /* Imagen más chica */
        width: auto; /* Mantiene proporción */
        display: block;
        margin: 0 auto; /* Centra horizontalmente */
        border-radius: 12px;
    }

    .card-body {
        background-color: #fff;
        padding: 20px;
        display: flex;
        flex-direction: column;
        height: 100%;
        text-align: center; /* <-- Esto centra el contenido de texto */
    }

    .btn-eterea {
        background-color: rgb(209, 167, 180);
        color: white;
        width: 100%;
        border: none;
        border-radius: 8px;
        padding: 10px;
        font-size: 1rem;
        transition: background-color 0.3s ease, transform 0.2s ease;
    }

        .btn-eterea:hover {
            background-color: rgb(189, 147, 160);
            transform: scale(1.02);
            color: white;
        }

    .pagination .page-link {
        color: rgb(209, 167, 180);
    }

    .pagination .page-item.active .page-link {
        background-color: rgb(209, 167, 180);
        border-color: rgb(209, 167, 180);
        color: white;
    }
</style>
