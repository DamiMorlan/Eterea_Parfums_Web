@model Eterea_Parfums_Web.ViewModels.VistaPreviaPedidoViewModel
@using Eterea_Parfums_Web.ViewModels

@using System.Globalization
@{
    var ciAR = new CultureInfo("es-AR");
}

@section Styles {
    <link href="~/Content/StyleCarrito.css" rel="stylesheet" />
    <link href="~/Content/StyleVistaPrevia.css" rel="stylesheet" />
    <link href="~/Content/StyleVistaPreviaPedido.css" rel="stylesheet" />
}

<div class="container mt-4 d-flex align-items-center justify-content-between">

    <div class="d-flex align-items-center">
        <a href="@Url.Action("Index","Carrito")" class="btn-volver me-3">← Volver</a>
    </div>

</div>

<div class="container mt-3">

    <div class="row">

        <!-- ===== COLUMNA IZQUIERDA: DIRECCIÓN ===== -->
        <div class="col-md-4">
            <div class="box">
                <h4 class="titulo-box">Dirección de envío</h4>

                @if (!string.IsNullOrEmpty(Model.DomicilioDeEnvioTexto))
                {
                    <pre>@Model.DomicilioDeEnvioTexto</pre>
                }
                else
                {
                    <div class="alert alert-warning">No se pudo determinar el domicilio de envío.</div>
                }

                <a href="@Url.Action("SeleccionarDireccion","Cliente")"
                   class="btn-cambiar-direccion w-100 mt-2">
                    Cambiar dirección
                </a>
            </div>
        </div>

        <!-- ===== COLUMNA DERECHA: PRODUCTOS + RESUMEN ===== -->
        <div class="col-md-8">

            <!-- Caja de productos -->
            <div class="box">
                <h4 class="titulo-box">Productos en tu pedido</h4>

                @foreach (var item in Model.Items)
                {
                    <div class="producto-item">
                        <a href="@Url.Action("Details", "Perfume", new { id = item.PerfumeId })">
                            <img src="@Url.Content("~/Imagenes/" + item.Imagen + ".jpg")"
                                 alt="@item.Nombre"
                                 class="rounded" />
                        </a>

                        <div class="ms-3 w-100">
                            <a href="@Url.Action("Details", "Perfume", new { id = item.PerfumeId })"
                               class="text-decoration-none text-dark">
                                <strong>@item.Nombre</strong>
                            </a>
                            <div>@item.Presentacion ml</div>
                        </div>

                        <div class="text-center w-25">
                            @item.Cantidad @((item.Cantidad == 1) ? "unidad" : "unidades")
                        </div>

                        <div class="text-end w-25 precio-item">
                            $ @item.TotalSinDescuento.ToString("N2", ciAR)
                        </div>

                    </div>
                }
            </div>

            <!-- Caja del resumen final -->
            <div class="box resumen">

                <h4 class="titulo-box titulo-resumen">Resumen de compra</h4>

                <div class="fila-resumen">
                    <span>Subtotal:</span>
                    <span>$ @Model.Subtotal.ToString("N2", ciAR)</span>
                </div>

                <div class="fila-resumen">
                    <span>Descuentos:</span>
                    <span class="text-danger">- $ @Model.Descuento.ToString("N2", ciAR)</span>
                </div>

                <div class="fila-resumen total">
                    <span>Total a pagar:</span>
                    <span>$ @Model.Total.ToString("N2", ciAR)</span>
                </div>

                @if (Model.EnvioGratis)
                {
                    <div class="mt-2 text-center" style="color: var(--bordo); font-weight: bold;">
                        ¡Felicidades! Tu envío es gratis
                    </div>
                }
                else
                {
                    <p style="font-size:.9rem; color: var(--bordo); font-weight: bold;">
                        Envío gratis a partir de $70.000.
                    </p>
                }

                <div class="text-center mt-3">
                    <a href="@Url.Action("SimularPago", "Pedido",
                            new { monto = Model.Total.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) })"
                       class="btn btn-lg btn-de-pagar">
                        Ir a Pagar
                    </a>
                </div>

                <p class="text-muted mt-2 text-center" style="font-size:.9rem;">
                    Serás redirigido a Mercado Pago
                </p>

            </div>

        </div>
    </div>
</div>
