@model Eterea_Parfums_Web.ViewModels.VistaPreviaPedidoViewModel


<style>
    .volver-carrito {
        font-size: 1.5rem;
        text-decoration: none;
        margin-bottom: 15px;
        display: inline-block;
    }

        .volver-carrito:hover {
            color: #007bff;
            text-decoration: none;
        }

    .resumen-producto {
        display: flex;
        align-items: center;
        margin-bottom: 15px;
        border-bottom: 1px solid #ddd;
        padding-bottom: 10px;
    }

        .resumen-producto img {
            width: 60px;
            height: 60px;
            object-fit: cover;
            margin-right: 10px;
        }

    .volver-carrito {
        display: inline-block;
        background-color: #ffe6f0; /* rosado claro */
        color: rgb(209, 167, 180); /* rosado oscuro */
        font-size: 1.5rem;
        padding: 6px 12px;
        border-radius: 6px;
        text-decoration: none;
        font-weight: bold;
        transition: background-color 0.3s;
    }

        .volver-carrito:hover {
            background-color: #f8bbd0; /* más oscuro al pasar */
            color: #880e4f;
            text-decoration: none;
        }

    .resumen-producto {
        display: flex;
        align-items: center;
        margin-bottom: 15px;
        border-bottom: 1px solid #ddd;
        padding-bottom: 10px;
    }

        .resumen-producto img {
            width: 60px;
            height: 60px;
            object-fit: cover;
            margin-right: 10px;
        }
</style>

<div class="container mt-4">
    <!-- Flecha volver -->
    <a href="@Url.Action("Index", "Carrito")" class="volver-carrito" title="Volver al carrito">
        ←
    </a>


    <div class="row mt-3">
        <!-- Dirección -->
        <div class="col-md-4" style="border-right: 2px solid #ddd;">
            <h4>Dirección de envío</h4>
            @if (Model != null)
            {
                <p>
                    @if (Model.Calle != null)
                    {
                        <text>@Model.Calle.nombre, </text>
                    }
                    @Model.Cliente.numeracion_calle

                    @if (!string.IsNullOrEmpty(Model.Cliente.piso))
                    {
                        <text>Piso @Model.Cliente.piso</text>
                    }
                    @if (!string.IsNullOrEmpty(Model.Cliente.departamento))
                    {
                        <text> Dpto. @Model.Cliente.departamento</text>
                    }
                    <br />
                    @if (Model.Localidad != null && Model.Provincia != null)
                    {
                        <text>
                            @Model.Cliente.codigo_postal, @Model.Localidad.nombre, @Model.Provincia.nombre
                        </text>
                    }
                </p>
            }
            else
            {
                <div class="alert alert-warning">No se pudieron cargar los datos del pedido.</div>
            }


            <a href="@Url.Action("SeleccionarDireccion", "Cliente")" class="btn btn-outline-secondary">
                Cambiar dirección de envío
            </a>
        </div>

        <!-- Productos y resumen -->
        <div class="col-md-8">
            <h4>Resumen de compra</h4>

            @foreach (var item in Model.ItemsCarrito)
            {
                var totalPorItem = item.Precio * item.Cantidad;
                <div class="resumen-producto">
                    <img src="@Url.Content("~/Imagenes/" + item.Imagen + ".jpg")" alt="@item.Nombre" />
                    <div class="ms-2 w-100">
                        <div><strong>@item.Nombre</strong></div>
                        <div>@item.Presentacion ml</div>
                    </div>
                    <div class="text-center w-25">@item.Cantidad x</div>
                    <div class="text-end w-25">$@totalPorItem.ToString("N0")</div>
                </div>
            }

            <div class="mt-4">
                <p>Subtotal (sin descuento): $@Model.Subtotal.ToString("N0")</p>
                <p style="color: #c0392b; font-weight: bold;">
                    Descuentos aplicados: -$@Model.Descuento.ToString("N0")
                </p>
                <h5>Total a pagar: $@Model.Total.ToString("N0")</h5>
            </div>


            @using (Html.BeginForm("IrAPagar", "Pedido", FormMethod.Post))
            {
                for (int i = 0; i < Model.ItemsCarrito.Count; i++)
                {
                    <input type="hidden" name="productos[@i].PerfumeId" value="@Model.ItemsCarrito[i].PerfumeId" />
                    <input type="hidden" name="productos[@i].Nombre" value="@Model.ItemsCarrito[i].Nombre" />
                    <input type="hidden" name="productos[@i].Cantidad" value="@Model.ItemsCarrito[i].Cantidad" />
                    <input type="hidden" name="productos[@i].Precio" value="@Model.ItemsCarrito[i].Precio" />
                }

                <button type="submit" class="btn btn-success mt-3">Ir a Pagar</button>
            }



            <p class="text-muted mt-2" style="font-size: 0.9rem;">Será redireccionado a Mercado Pago</p>
        </div>
    </div>
</div>
