    ViewBag.Title = "Pago exitoso";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link href="~/Content/StylePagoExitoso.css" rel="stylesheet" type="text/css" />
}
<!--<div class="container text-center my-5">
    <h2 class="text-success">¡Pago aprobado!</h2>
    <p>@TempData["PagoOK"]</p>
    <p class="text-muted">Serás redirigido en 5 segundos…</p>
