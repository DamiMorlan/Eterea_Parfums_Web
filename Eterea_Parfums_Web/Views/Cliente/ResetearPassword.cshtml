@model Eterea_Parfums_Web.ViewModels.ResetearPasswordViewModel
@{
    ViewBag.Title = "ResetearPassword";
}

@section Styles {
    <link href="~/Content/StyleOlvidarPassword.css" rel="stylesheet" type="text/css" />
}


<div class="pass-wrapper">
    <div class="recovery-pass">
        <!-- Logo -->
        <div class="logo-eterea-container text-center mb-4">
            <img src="@Url.Action("Mostrar", "Imagen", new { nombre = "LogoEterea.png" })" alt="Logo Eterea Parfums" class="logo-eterea" />
        </div>

        <h2>Restablecer Contraseña</h2>
        <hr class="separator" />
        @using (Html.BeginForm())
        {
            @Html.HiddenFor(m => m.Token)

            <div class="form-group">
                @Html.LabelFor(m => m.NuevaPassword)
                @Html.PasswordFor(m => m.NuevaPassword, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.NuevaPassword, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.ConfirmarPassword)
                @Html.PasswordFor(m => m.ConfirmarPassword, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.ConfirmarPassword, "", new { @class = "text-danger" })
            </div>

            <button type="submit" class="btn-recovery mt-2">Guardar nueva contraseña</button>
        }
    </div>
</div>






