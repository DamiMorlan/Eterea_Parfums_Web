@model Eterea_Parfums_Web.ViewModels.OlvidarPasswordViewModel
@{
    ViewBag.Title = "OlvidarPassword";
}

@section Styles {
    <link href="~/Content/StyleOlvidarPassword.css" rel="stylesheet" type="text/css" />
}



<div class="pass-wrapper">
    <div class="recovery-pass">
        <!-- Logo -->
        <div class="logo-eterea-container text-center mb-4">
            <img src="@Url.Content("~/Imagenes/LogoEterea.png")" alt="Logo Eterea Parfums" class="logo-eterea" />
        </div>

        <h2>Recuperar contraseña</h2>
        <hr class="separator" />
        @if (ViewBag.Mensaje != null)
        {
            <div class="alert alert-info text-center">
                @ViewBag.Mensaje
            </div>
        }
        @using (Html.BeginForm())
        {
            <div class="form-group">
                @Html.LabelFor(m => m.Email, htmlAttributes: new { @class = "control-label" })
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", @placeholder = "Ingresá tu correo" })
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
            </div>
            <button type="submit" class="btn-recovery mt-2">Enviar instrucciones</button>
        }

    </div>
</div>


