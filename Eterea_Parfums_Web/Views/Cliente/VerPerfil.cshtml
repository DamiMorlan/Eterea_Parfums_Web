@{
    ViewBag.Title = "Perfil";
}

@section Styles {
    <link href="~/Content/StyleVerPerfil.css" rel="stylesheet" type="text/css" />
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

@model Eterea_Parfums_Web.Models.cliente

<div class="register-container">
    <h2 class="text-center">@ViewBag.Title</h2>
    <hr class="separator" />

    <h4 class="subtitulo">Información Personal</h4>
    <div class="row">
        <div class="col-md-6">
            <div class="info-box">
                <p><strong>Nombre:</strong> @Model.nombre</p>
                <p><strong>Apellido:</strong> @Model.apellido</p>
                <p><strong>Usuario:</strong> @Model.usuario</p>
                <p><strong>Email:</strong> @Model.e_mail</p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="info-box">
                <p><strong>DNI:</strong> @Model.dni</p>
                <p><strong>Fecha de Nacimiento:</strong> @Model.fecha_nacimiento.ToString("dd/MM/yyyy")</p>
                <p><strong>Celular:</strong> @Model.celular</p>
                <p><strong>Condición frente al IVA:</strong> @Model.condicion_frente_al_iva</p>
            </div>
        </div>
    </div>

    <hr class="separator" />

    <h4 class="subtitulo">Domicilio</h4>
    <div class="row">
        <div class="col-md-6">
            <div class="info-box">
                <p><strong>País:</strong> @Model.pais.nombre</p>
                <p><strong>Provincia:</strong> @Model.provincia.nombre</p>
                <p><strong>Localidad:</strong> @Model.localidad.nombre</p>
                <p><strong>Calle:</strong> @Model.calle.nombre</p>
                <p><strong>Numeración:</strong> @Model.numeracion_calle</p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="info-box">
                <p><strong>Piso:</strong> @Model.piso</p>
                <p><strong>Departamento:</strong> @Model.departamento</p>
                <p><strong>Código Postal:</strong> @Model.codigo_postal</p>
                <p><strong>Comentario del domicilio:</strong> @Model.comentarios_domicilio</p>
            </div>
        </div>
    </div>

    <div class="text-center">
        @Html.ActionLink("Editar Perfil", "Perfil", "Cliente", null, new { @class = "btn-register" })
    </div>
</div>

<div style="margin-bottom: 50px;"></div>
