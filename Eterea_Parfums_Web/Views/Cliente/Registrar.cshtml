@{
    ViewBag.Title = "Registro";
}
@model Eterea_Parfums_Web.Models.cliente




<div class="register-container">
    <h2 id="title" class="text-center">@ViewBag.Title</h2>
    <hr class="separator">
    @using (Html.BeginForm("Registrar", "Cliente", FormMethod.Post, new { @class = "register-form" }))
    {
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label for="nombre">Nombre:</label>
                    @Html.TextBoxFor(m => m.nombre, new { @class = "form-control", required = "required" })
                    @Html.ValidationMessageFor(m => m.nombre, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <label for="apellido">Apellido:</label>
                    @Html.TextBoxFor(m => m.apellido, new { @class = "form-control", required = "required" })
                    @Html.ValidationMessageFor(m => m.apellido, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <label for="usuario">Nombre de usuario:</label>
                    @Html.TextBoxFor(m => m.usuario, new { @class = "form-control", required = "required" })
                    @Html.ValidationMessageFor(m => m.usuario, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <label for="clave">Contraseña:</label>
                    <input type="password" id="clave" name="clave" class="form-control" required />
                </div>

                <div class="form-group">
                    <label for="email">E-mail:</label>
                    @Html.TextBoxFor(m => m.e_mail, new { @class = "form-control", type = "email", required = "required" })
                    @Html.ValidationMessageFor(m => m.e_mail, "", new { @class = "text-danger" })
                    @Html.ValidationMessage("email")
                </div>

                <div class="form-group">
                    <label for="dni">DNI:</label>
                    @Html.TextBoxFor(m => m.dni, new { @class = "form-control", required = "required" })
                    @Html.ValidationMessageFor(m => m.dni, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <label for="fechaNacimiento">Fecha de Nacimiento:</label>
                    <input type="date" id="fechaNacimiento" name="fecha_nacimiento" class="form-control" required />
                    @Html.ValidationMessage("fechaNacimiento")
                </div>

                <div class="form-group">
                    <label for="celular">Celular:</label>
                    @Html.TextBoxFor(m => m.celular, new { @class = "form-control", required = "required" })
                    @Html.ValidationMessageFor(m => m.celular, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group">
                    <label for="pais">País:</label>
                    <select id="pais" name="pais_id" class="form-control" required>
                        <option value="">Seleccione un país</option>
                        @foreach (var pais in ViewBag.Paises as List<SelectListItem>)
                        {
                            <option value="@pais.Value">@pais.Text</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label for="provincia">Provincia:</label>
                    <select id="provincia" name="provincia_id" class="form-control" required>
                        <option value="">Seleccione una provincia</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="localidad">Localidad:</label>
                    <select id="localidad" name="localidad_id" class="form-control" required>
                        <option value="">Seleccione una localidad</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="calle">Calle:</label>
                    <select id="calle" name="calle_id" class="form-control" required>
                        <option value="">Seleccione una calle</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="numeracion">Numeración:</label>
                    @Html.TextBoxFor(m => m.numeracion_calle, new { @class = "form-control", required = "required" })
                    @Html.ValidationMessageFor(m => m.numeracion_calle, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <label for="piso">Piso:</label>
                    @Html.TextBoxFor(m => m.piso, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.piso, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <label for="departamento">Departamento:</label>
                    @Html.TextBoxFor(m => m.departamento, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.departamento, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <label for="codigopostal">Código Postal:</label>
                    @Html.TextBoxFor(m => m.codigo_postal, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.codigo_postal, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                <label for="comentarios">Comentarios del domicilio:</label>
                @Html.TextAreaFor(m => m.comentarios_domicilio, new { @class = "form-control", rows = 3, maxlength = 50 })
                @Html.ValidationMessageFor(m => m.comentarios_domicilio, "", new { @class = "text-danger" })
            </div>
        </div>

        <hr class="separator">

        <button type="submit" class="btn-register">Registrarse</button>
    }
</div>

<div style="margin-bottom: 50px;"></div> <!-- Espacio debajo del contenedor -->
