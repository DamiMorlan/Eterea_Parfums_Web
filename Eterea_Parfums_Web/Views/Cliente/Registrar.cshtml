@{
    ViewBag.Title = "Registro";
}

@section Styles {
    <link href="~/Content/StyleRegistro.css" rel="stylesheet" type="text/css" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

    <!-- Select2 -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

    <style>
        /* --- Adaptar Select2 al estilo .form-control rosa --- */
        .select2-container--default .select2-selection--single {
            height: 45px !important;
            border: 1px solid #d9b8c1 !important;
            border-radius: 8px !important;
            padding: 6px 10px !important;
            font-size: 1em !important;
            box-shadow: none !important;
            transition: border-color 0.3s;
        }

            .select2-container--default .select2-selection--single:focus,
            .select2-container--default.select2-container--open .select2-selection--single {
                border-color: #a0435c !important;
            }

        .select2-container--default .select2-selection__arrow {
            height: 43px !important;
            right: 10px;
        }

        .select2-container .select2-selection--single .select2-selection__rendered {
            padding-left: 2px !important;
        }
    </style>
}

@model Eterea_Parfums_Web.ViewModels.FormularioClienteViewModel

<div class="register-container">
    <!-- Logo -->
    <div class="logo-eterea-container text-center mb-4">
        <img src="@Url.Content("~/Imagenes/LogoEterea.png")" alt="Logo Eterea Parfums" class="logo-eterea img-fluid" />
    </div>

    <h2 id="title" class="text-center">@ViewBag.Title</h2>

    @using (Html.BeginForm("Registrar", "Cliente", FormMethod.Post,
      new { @class = "register-form", autocomplete = "off" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="row">
            <div class="col-md-6">
                <!-- Campos personales -->
                <div class="form-group">
                    <label for="Nombre">Nombre:</label>
                    @Html.TextBoxFor(m => m.Nombre, new
                    {
                         @class = "form-control solo-letras",
                         required = "required",
                         maxlength = "24"
                     })
                    @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <label for="Apellido">Apellido:</label>
                    @Html.TextBoxFor(m => m.Apellido, new
                    {
                         @class = "form-control solo-letras",
                         required = "required",
                         maxlength = "24"
                     })
                    @Html.ValidationMessageFor(m => m.Apellido, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <label for="Usuario">Nombre de usuario:</label>
                    @Html.TextBoxFor(m => m.Usuario, new
               {
                   @class = "form-control",
                   required = "required",
                   autocomplete = "off",
                   minlength = "4",
                   maxlength = "8",
                   // solo letras (may/min) y números, de 4 a 8 caracteres
                   pattern = "^(?=.*[A-Za-z])(?=.*\\d)[A-Za-z\\d]{4,8}$",
                   title = "El nombre de usuario debe tener entre 4 y 8 caracteres, contener letras y números, y no puede ser solo letras ni solo números."
               })
                    @Html.ValidationMessageFor(m => m.Usuario, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <label for="Clave">Contraseña:</label>

                    <div class="input-group">
                        @Html.PasswordFor(m => m.Clave, new
                        {
                            @class = "form-control password-input",
                            required = "required",
                            pattern = @"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[!¡\""#\$%&/()=?¿]).{8,}$",
                            title = "La clave debe tener al menos 8 caracteres, incluir mayúsculas, minúsculas, números y un carácter especial.",
                            autocomplete = "new-password"
                        })
                        <button type="button" class="btn btn-outline-secondary toggle-password" tabindex="-1">
                            <i class="fa-solid fa-eye"></i>
                        </button>
                    </div>

                    <span id="password-error" class="text-danger d-none">
                        La contraseña debe tener al menos <strong>8 caracteres</strong>, incluir al menos una <strong>mayúscula</strong>,
                        una <strong>minúscula</strong>, un <strong>número</strong> y un <strong>carácter especial</strong>
                        (<code>!, ¡, ", #, $, %, &, /, (, ), =, ?, ¿</code>).
                    </span>

                    @Html.ValidationMessageFor(m => m.Clave, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <label for="Email">Email:</label>
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", required = "required" })
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <label for="Dni">DNI:</label>
                    @Html.TextBoxFor(m => m.Dni, new
                    {
                        @class = "form-control solo-numeros-8",
                        type = "text",
                        required = "required",
                        autocomplete = "off",
                        maxlength = "8",
                        minlength = "8",
                        pattern = "^[0-9]{8}$",
                        title = "El DNI debe tener exactamente 8 dígitos numéricos."
                    })
                    @Html.ValidationMessageFor(m => m.Dni, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <label for="FechaNacimiento">Fecha de Nacimiento:</label>
                    @Html.TextBoxFor(m => m.FechaNacimiento, "{0:yyyy-MM-dd}", new
                    {
                        @class = "form-control",
                        type = "date",
                        max = DateTime.Now.AddYears(-18).ToString("yyyy-MM-dd")
                    })
                    @Html.ValidationMessageFor(m => m.FechaNacimiento, "", new { @class = "text-danger" })
                </div>


                <div class="form-group">
                    <label for="Celular">Celular:</label>
                    @Html.TextBoxFor(m => m.Celular, new
                    {
                        @class = "form-control solo-numeros-13",
                        required = "required",
                        maxlength = "13",
                        pattern = "^[0-9]{1,13}$",
                        title = "El celular debe contener solo números (hasta 13 dígitos)."
                    })
                    @Html.ValidationMessageFor(m => m.Celular, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="col-md-6">
                <!-- Ubicación -->
                <div class="form-group">
                    <label for="PaisId">País:</label>
                    @Html.DropDownListFor(
                        m => m.PaisId,
                        ViewBag.Paises as List<SelectListItem>,
                        "Seleccione un país",
                        new { @class = "form-control select2", id = "pais" })
                    @Html.ValidationMessageFor(m => m.PaisId, "", new { @class = "text-danger", id = "error-pais"})
                </div>


                <div class="form-group">
                    <label for="ProvinciaId">Provincia:</label>
                    @Html.DropDownListFor(
                        m => m.ProvinciaId,
                        new List<SelectListItem>(), // se llena por JS
                        "Seleccione una provincia",
                        new { @class = "form-control select2", id = "provincia" })
                    @Html.ValidationMessageFor(m => m.ProvinciaId, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <label for="LocalidadId">Localidad:</label>
                    @Html.DropDownListFor(
                        m => m.LocalidadId,
                        new List<SelectListItem>(),
                        "Seleccione una localidad",
                        new { @class = "form-control select2", id = "localidad" })
                    @Html.ValidationMessageFor(m => m.LocalidadId, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <label for="CalleId">Calle:</label>
                    @Html.DropDownListFor(
                        m => m.CalleId,
                        new List<SelectListItem>(),
                        "Seleccione una calle",
                        new { @class = "form-control select2", id = "calle" })
                    @Html.ValidationMessageFor(m => m.CalleId, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <label for="NumeracionCalle">Numeración:</label>
                    @Html.TextBoxFor(m => m.NumeracionCalle, new
                    {
                        @class = "form-control solo-numeros",
                        required = "required",
                        maxlength = "6",
                        pattern = "^[0-9]{1,6}$",
                        title = "Solo números para la numeración."
                    })
                    @Html.ValidationMessageFor(m => m.NumeracionCalle, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <label for="Piso">Piso:</label>
                    @Html.TextBoxFor(m => m.Piso, new
                    {
                        @class = "form-control piso-depto",
                        maxlength = "3",
                        pattern = "^([0-9]{1,3}|[A-Za-z]{1,3})$",
                        title = "El piso puede ser hasta 3 números o hasta 3 letras, pero no mezclados."
                    })
                    @Html.ValidationMessageFor(m => m.Piso, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <label for="Departamento">Departamento:</label>
                    @Html.TextBoxFor(m => m.Departamento, new
                    {
                        @class = "form-control piso-depto",
                        maxlength = "3",
                        pattern = "^([0-9]{1,3}|[A-Za-z]{1,3})$",
                        title = "El departamento puede ser solo letras o solo números (hasta 3 caracteres, sin mezclar)."
                    })
                    @Html.ValidationMessageFor(m => m.Departamento, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <label for="CodigoPostal">Código Postal:</label>
                    @Html.TextBoxFor(m => m.CodigoPostal, new
                    {
                        @class = "form-control solo-cp",
                        maxlength = "4",
                        minlength = "4",
                        pattern = "^[0-9]{4}$",
                        title = "El código postal debe tener exactamente 4 dígitos numéricos."
                    })
                    @Html.ValidationMessageFor(m => m.CodigoPostal, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group col-md-12">
                <label for="ComentariosDomicilio">Comentarios del domicilio:</label>
                @Html.TextAreaFor(m => m.ComentariosDomicilio, new { @class = "form-control", rows = 3, maxlength = 50 })
                @Html.ValidationMessageFor(m => m.ComentariosDomicilio, "", new { @class = "text-danger" })
            </div>

            <hr class="separator" />
            <div class="col-md-12 text-center">
                <button type="submit" class="btn-register">Registrarse</button>
            </div>
        </div>
    }
</div>

<div style="margin-bottom: 50px;"></div>

@section Scripts {
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
    $(document).ready(function () {
    // Inicializar Select2
        $('.select2').select2({
            width: '100%',
            placeholder: "Seleccione una opción",
            allowClear: true,
            containerCssClass: "mi-select2",        // clase personalizada para el contenedor
            dropdownCssClass: "mi-select2-dropdown" // clase personalizada para el dropdown
        });

        //Solo letras en Nombre y Apellido
        //(inputs que tengan la clase "solo-letras")
        $('.solo-letras').on('input', function () {
            this.value = this.value.replace(/[^A-Za-zÁÉÍÓÚÜÑáéíóúüñ\s]/g, '');
        });

        // Solo números genérico (ej: numeración de calle)
        $('.solo-numeros').on('input', function () {
            this.value = this.value.replace(/[^0-9]/g, '');
        });

        // DNI: solo números, máximo 8 (el pattern del input valida exactamente 8 al enviar)
        $('.solo-numeros-8').on('input', function () {
            this.value = this.value.replace(/[^0-9]/g, '').slice(0, 8);
        });

        // Celular: solo números, hasta 13 dígitos
        $('.solo-numeros-13').on('input', function () {
            this.value = this.value.replace(/[^0-9]/g, '').slice(0, 13);
        });

        function validarMayorDe18() {
            const input = document.getElementById('FechaNacimiento');
            if (!input) return true;

            const val = input.value;
            if (!val) {
                input.setCustomValidity('');
                return true; // no completó fecha → lo valida el "required" si lo agregás
            }

            const fechaNac = new Date(val);
            const hoy = new Date();

            let edad = hoy.getFullYear() - fechaNac.getFullYear();
            const mes = hoy.getMonth() - fechaNac.getMonth();
            if (mes < 0 || (mes === 0 && hoy.getDate() < fechaNac.getDate())) {
                edad--;
            }

            if (edad < 18) {
                input.setCustomValidity('Debes ser mayor de 18 años para registrarte.');
                input.reportValidity();
                return false;
            } else {
                input.setCustomValidity('');
                return true;
            }
        }

        // Validar cuando cambia la fecha
        $('#FechaNacimiento').on('change', function () {
            validarMayorDe18();
        });

        // Validar también al enviar el formulario
        $('form.register-form').on('submit', function (e) {
            if (!validarMayorDe18()) {
                e.preventDefault();
            }
        });


        // Piso / Departamento:
        // - Máx 3 caracteres
        // - Si el primer carácter es letra → solo letras
        // - Si el primer carácter es número → solo números
        $('.piso-depto').on('input', function () {
            let v = this.value;

            // quitar todo lo que no sea letra o número
            v = v.replace(/[^A-Za-z0-9]/g, '');

            if (v.length === 0) {
                this.value = '';
                return;
            }

            const first = v.charAt(0);

            if (/[A-Za-z]/.test(first)) {
                // primer carácter es letra → todo letras
                v = v.replace(/[^A-Za-z]/g, '');
            } else if (/[0-9]/.test(first)) {
                // primer carácter es número → todo números
                v = v.replace(/[^0-9]/g, '');
            }

            this.value = v.slice(0, 3);
        });

        // Código postal: solo números, máx 4
        $('.solo-cp').on('input', function () {
            this.value = this.value.replace(/[^0-9]/g, '').slice(0, 4);
        });


        // Inicialmente deshabilitar los dependientes
        $('#provincia, #localidad, #calle').prop('disabled', true);

        // Función genérica para llenar selects dinámicos
        function cargarSelect(url, parametro, selectDestino) {
            $.getJSON(url, parametro, function (data) {
                var $select = $(selectDestino);
                $select.empty().append('<option></option>'); // placeholder
                $.each(data, function (i, item) {
                    $select.append(new Option(item.nombre, item.id, false, false));
                });
                $select.prop('disabled', false).trigger('change');
            });
        }

        // Cambio de país → provincias
        $('#pais').change(function () {
            var paisId = $(this).val();

            // Si eligió un país válido, ocultar el error
            if (paisId) {
                $('#error-pais').text('').hide();
            }

            // Limpiar y deshabilitar dependientes
            $('#provincia').val(null).trigger('change').prop('disabled', !paisId);
            $('#localidad').val(null).trigger('change').prop('disabled', true);
            $('#calle').val(null).trigger('change').prop('disabled', true);

            if (paisId) cargarSelect('/Cliente/ObtenerProvincias', { paisId: paisId }, '#provincia');
        });

        // Cambio de provincia → localidades
        $('#provincia').change(function () {
            var provinciaId = $(this).val();

            // Limpiar y deshabilitar dependientes
            $('#localidad').val(null).trigger('change').prop('disabled', !provinciaId);
            $('#calle').val(null).trigger('change').prop('disabled', true);

            if (provinciaId) cargarSelect('/Cliente/ObtenerLocalidades', { provinciaId: provinciaId }, '#localidad');
        });

        // Cambio de localidad → calles
        $('#localidad').change(function () {
            var localidadId = $(this).val();

            // Limpiar y deshabilitar calle
            $('#calle').val(null).trigger('change').prop('disabled', !localidadId);

            if (localidadId) cargarSelect('/Cliente/ObtenerCalles', { localidadId: localidadId }, '#calle');
        });

        // Precargar valores si estamos editando
        var paisSelected = '@Model.PaisId';
        var provinciaSelected = '@Model.ProvinciaId';
        var localidadSelected = '@Model.LocalidadId';
        var calleSelected = '@Model.CalleId';

        if (paisSelected) {
            $('#pais').val(paisSelected).trigger('change');

            if (provinciaSelected) {
                setTimeout(function () {
                    $('#provincia').val(provinciaSelected).trigger('change');
                }, 300);
            }
            if (localidadSelected) {
                setTimeout(function () {
                    $('#localidad').val(localidadSelected).trigger('change');
                }, 600);
            }
            if (calleSelected) {
                setTimeout(function () {
                    $('#calle').val(calleSelected).trigger('change');
                }, 900);
            }
        }

        $(document).ready(function () {
            const passwordInput = $('input[name="Clave"]');
            passwordInput.on('input', function () {
                const value = $(this).val();
                const regex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[!¡\""#\$%&/()=?¿]).{8,}$/;

                if (regex.test(value)) {
                    $(this).css('border-color', '#28a745'); // verde
                } else {
                    $(this).css('border-color', '#dc3545'); // rojo
                }
            });
        });


        // Mostrar/ocultar contraseña
        $(document).on('click', '.toggle-password', function () {
            const passwordInput = $(this).siblings('.password-input');
            const icon = $(this).find('i');

            if (passwordInput.attr('type') === 'password') {
                passwordInput.attr('type', 'text');
                icon.removeClass('fa-eye').addClass('fa-eye-slash');
            } else {
                passwordInput.attr('type', 'password');
                icon.removeClass('fa-eye-slash').addClass('fa-eye');
            }
        });

        // Validación dinámica y al enviar formulario
        $(document).ready(function () {
            const passwordInput = $('.password-input');
            const passwordError = $('#password-error');
            const regex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[!¡\""#\$%&/()=?¿]).{8,}$/;

            // Mostrar mensaje si no cumple mientras escribe
            passwordInput.on('input', function () {
                const value = $(this).val();
                if (!regex.test(value)) {
                    passwordError.removeClass('d-none');
                    passwordInput.css('border-color', '#dc3545'); // rojo
                } else {
                    passwordError.addClass('d-none');
                    passwordInput.css('border-color', '#28a745'); // verde
                }
            });

            // Evitar enviar el formulario si no cumple
            $('form.register-form').on('submit', function (e) {
                const value = passwordInput.val();
                if (!regex.test(value)) {
                    e.preventDefault();
                    passwordError.removeClass('d-none');
                    passwordInput.css('border-color', '#dc3545');
                }
            });
        });

    });


    </script>

}
