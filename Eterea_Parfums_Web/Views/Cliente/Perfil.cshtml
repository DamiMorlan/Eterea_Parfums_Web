@model Eterea_Parfums_Web.Models.cliente
@{
    ViewBag.Title = "Mi Perfil";
}
@section Styles {
    <link href="~/Content/LoginStyle.css" rel="stylesheet" type="text/css" />
}


<div class="register-container">
    <h2 id="title" class="text-center">@ViewBag.Title</h2>
    <hr class="separator">
    @Html.ActionLink("Ver Compras realizadas", "Index", "Historial", null, new { @class = "btn btn-primary" })
    <!-- MODIFICAR el class = "perfil-form" cuando este el CSS -->
    @using (Html.BeginForm("Perfil", "Cliente", FormMethod.Post, new { @class = "perfil-form" }))
    {
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label for="nombre">Nombre:</label>
                    @Html.TextBoxFor(m => m.nombre, new { @class = "form-control", required = "required" })
                </div>

                <div class="form-group">
                    <label for="apellido">Apellido:</label>
                    @Html.TextBoxFor(m => m.nombre, new { @class = "form-control", required = "required" })
                </div>

                <div class="form-group">
                    <label for="usuario">Nombre de Usuario:</label>
                    @Html.TextBoxFor(m => m.usuario, new { @class = "form-control", required = "required" })
                    @Html.ValidationMessage("usuario")
                </div>

                <div class="form-group">
                    <label for="clave">Contraseña:</label>
                    @Html.TextBoxFor(m => m.clave, new { @class = "form-control", required = "required" })
                </div>

                <div class="form-group">
                    <label for="email">E-mail:</label>
                    @Html.TextBoxFor(m => m.e_mail, new { @class = "form-control", required = "required" })
                    @Html.ValidationMessage("email")
                </div>

                <div class="form-group">
                    <label for="dni">DNI:</label>
                    @Html.TextBoxFor(m => m.dni, new { @class = "form-control", required = "required" })
                    @Html.ValidationMessage("dni")
                </div>

                <div class="form-group">
                    <label for="fechaNacimiento">Fecha de Nacimiento:</label>
                    <input type="date" id="fechaNacimiento" name="fechaNacimiento" class="form-control" required />
                    @Html.ValidationMessage("fechaNacimiento")
                </div>

                <div class="form-group">
                    <label for="celular">Celular:</label>
                    @Html.TextBoxFor(m => m.celular, new { @class = "form-control", required = "required" })
                    @Html.ValidationMessage("celular")
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group">
                    <label for="pais">País:</label>
                    <select id="pais" name="pais" class="form-control" required>
                        <option value="">Seleccione un país</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="provincia">Provincia:</label>
                    <select id="provincia" name="provincia" class="form-control" required>
                        <option value="">Seleccione una provincia</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="localidad">Localidad:</label>
                    <select id="localidad" name="localidad" class="form-control" required>
                        <option value="">Seleccione una localidad</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="calle">Calle:</label>
                    <select id="calle" name="calle" class="form-control" required>
                        <option value="">Seleccione una calle</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="numeracion">Numeración:</label>
                    @Html.TextBoxFor(m => m.numeracion_calle, new { @class = "form-control", required = "required" })
                    @Html.ValidationMessage("numeracion")
                </div>

                <div class="form-group">
                    <label for="piso">Piso:</label>
                    @Html.TextBoxFor(m => m.piso, new { @class = "form-control", required = "required" })
                    @Html.ValidationMessage("piso")
                </div>

                <div class="form-group">
                    <label for="departamento">Departamento:</label>
                    @Html.TextBoxFor(m => m.departamento, new { @class = "form-control", required = "required" })
                    @Html.ValidationMessage("departamento")
                </div>

                <div class="form-group">
                    <label for="codigopostal">Código Postal:</label>
                    @Html.TextBoxFor(m => m.codigo_postal, new { @class = "form-control", required = "required" })
                    @Html.ValidationMessage("codigopostal")
                </div>
            </div>
            <div class="form-group">
                <label for="comentarios">Comentario del domicilio:</label>
                @Html.TextAreaFor(m => m.comentarios_domicilio, new { @class = "form-control", required = "required" })
                @Html.ValidationMessage("comentarios")
            </div>
        </div>

        <hr class="separator">

        <button type="submit" class="btn-register">Guardar cambios</button>
    }
</div>

<div style="margin-bottom: 50px;"></div> <!-- Espacio debajo del contenedor -->
