@model Eterea_Parfums_Web.ViewModels.FormularioPerfilViewModel

@{
    ViewBag.Title = "Mi Perfil";
}

@section Styles {
    <link href="~/Content/StyleRegistro.css" rel="stylesheet" type="text/css" />

    <!-- Select2 -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

    <style>
        /* --- Adaptar Select2 al estilo .form-control rosa --- */
        .select2-container--default .select2-selection--single {
            height: 45px !important;
            border: 1px solid #d9b8c1 !important;
            border-radius: 8px !important;
            padding: 6px 10px !important;
            font-size: 1em !important;
            box-shadow: none !important;
            transition: border-color 0.3s;
        }

            .select2-container--default .select2-selection--single:focus,
            .select2-container--default.select2-container--open .select2-selection--single {
                border-color: #a0435c !important;
            }

        .select2-container--default .select2-selection__arrow {
            height: 43px !important;
            right: 10px;
        }

        .select2-container .select2-selection--single .select2-selection__rendered {
            padding-left: 2px !important;
        }
    </style>
}

<div class="register-container">
    <h2 class="text-center">@ViewBag.Title</h2>

    @if (TempData["AvisoPasswordInsegura"] != null)
    {
        <div class="alert alert-warning text-center mt-3 mb-3">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>
            @TempData["AvisoPasswordInsegura"]
        </div>
    }

    @using (Html.BeginForm("Perfil", "Cliente", FormMethod.Post, new { @class = "register-form" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    @Html.LabelFor(m => m.Nombre)
                    @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger" })
                    @if (string.Equals(Request.QueryString["primerLogin"], "true", StringComparison.OrdinalIgnoreCase))
                    {
                        <input type="hidden" name="primerLogin" value="true" />
                    }
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Apellido)
                    @Html.TextBoxFor(m => m.Apellido, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Apellido, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Usuario)
                    @Html.TextBoxFor(m => m.Usuario, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Usuario, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <label for="Clave">Nueva contraseña (opcional):</label>

                    <div class="input-group">
                        @Html.PasswordFor(m => m.Clave, new
                        {
                            @class = "form-control password-input",
                            @id = "password",
                            placeholder = "Dejar en blanco si no desea cambiarla",
                            pattern = @"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[!¡\""#\$%&/()=?¿]).{8,}$",
                            title = "La clave debe tener al menos 8 caracteres, incluir mayúsculas, minúsculas, números y un carácter especial."
                        })
                        <button type="button" class="btn toggle-password" tabindex="-1">
                            <i class="fa-solid fa-eye"></i>
                        </button>
                    </div>

                    <span id="password-error" class="text-danger d-none">
                        La contraseña debe tener al menos <strong>8 caracteres</strong>, incluir al menos una <strong>mayúscula</strong>,
                        una <strong>minúscula</strong>, un <strong>número</strong> y un <strong>carácter especial</strong>
                        (<code>!, ¡, ", #, $, %, &, /, (, ), =, ?, ¿</code>).
                    </span>

                    @Html.ValidationMessageFor(m => m.Clave, "", new { @class = "text-danger" })
                </div>




                <div class="form-group">
                    @Html.LabelFor(m => m.Email)
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email" })
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Dni)
                    @Html.TextBoxFor(m => m.Dni, new { @class = "form-control", type = "number" })
                    @Html.ValidationMessageFor(m => m.Dni, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.FechaNacimiento)
                    @Html.TextBoxFor(m => m.FechaNacimiento, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    @Html.ValidationMessageFor(m => m.FechaNacimiento, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Celular)
                    @Html.TextBoxFor(m => m.Celular, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Celular, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group">
                    @Html.LabelFor(m => m.PaisId)
                    @Html.DropDownListFor(m => m.PaisId, ViewBag.Paises as List<SelectListItem>,
                        "Seleccione un país", new { @class = "form-control select2", id = "pais", data_selected = Model.PaisId })
                    @Html.ValidationMessageFor(m => m.PaisId, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.ProvinciaId)
                    @Html.DropDownListFor(m => m.ProvinciaId, new List<SelectListItem>(),
                        "Seleccione una provincia", new { @class = "form-control select2", id = "provincia", data_selected = Model.ProvinciaId })
                    @Html.ValidationMessageFor(m => m.ProvinciaId, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.LocalidadId)
                    @Html.DropDownListFor(m => m.LocalidadId, new List<SelectListItem>(),
                        "Seleccione una localidad", new { @class = "form-control select2", id = "localidad", data_selected = Model.LocalidadId })
                    @Html.ValidationMessageFor(m => m.LocalidadId, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.CalleId)
                    @Html.DropDownListFor(m => m.CalleId, new List<SelectListItem>(),
                        "Seleccione una calle", new { @class = "form-control select2", id = "calle", data_selected = Model.CalleId })
                    @Html.ValidationMessageFor(m => m.CalleId, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.NumeracionCalle)
                    @Html.TextBoxFor(m => m.NumeracionCalle, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.NumeracionCalle, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Piso)
                    @Html.TextBoxFor(m => m.Piso, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Piso, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Departamento)
                    @Html.TextBoxFor(m => m.Departamento, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Departamento, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.CodigoPostal)
                    @Html.TextBoxFor(m => m.CodigoPostal, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.CodigoPostal, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group col-md-12">
                @Html.LabelFor(m => m.ComentariosDomicilio)
                @Html.TextAreaFor(m => m.ComentariosDomicilio, new { @class = "form-control", rows = 3, maxlength = 50 })
                @Html.ValidationMessageFor(m => m.ComentariosDomicilio, "", new { @class = "text-danger" })
            </div>

            <div class="col-md-12 text-center">
                <button type="submit" class="btn-register">Actualizar perfil</button>
            </div>
        </div>
    }
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
    $(document).ready(function () {
        // Inicializar Select2
        $(".select2").select2({
            width: '100%',
            placeholder: "Seleccione una opción",
            allowClear: true,
            language: {
                noResults: () => "No hay resultados",
                searching: () => "Buscando..."
            },
            containerCssClass: "mi-select2",
            dropdownCssClass: "mi-select2-dropdown"
        });

        // --- Lógica de los selects encadenados ---
        $('#provincia, #localidad, #calle').prop('disabled', true);

        function cargarSelect(url, parametro, selectDestino) {
            $.getJSON(url, parametro, function (data) {
                const $select = $(selectDestino);
                $select.empty().append('<option></option>');
                $.each(data, function (i, item) {
                    $select.append(new Option(item.nombre, item.id, false, false));
                });
                $select.prop('disabled', false).trigger('change');
            });
        }

        $('#pais').on('change', function () {
            const paisId = $(this).val();
            $('#provincia, #localidad, #calle').val(null).trigger('change').prop('disabled', true);
            if (paisId) cargarSelect('/Cliente/ObtenerProvincias', { paisId: paisId }, '#provincia');
        });

        $('#provincia').on('change', function () {
            const provinciaId = $(this).val();
            $('#localidad, #calle').val(null).trigger('change').prop('disabled', true);
            if (provinciaId) cargarSelect('/Cliente/ObtenerLocalidades', { provinciaId: provinciaId }, '#localidad');
        });

        $('#localidad').on('change', function () {
            const localidadId = $(this).val();
            $('#calle').val(null).trigger('change').prop('disabled', true);
            if (localidadId) cargarSelect('/Cliente/ObtenerCalles', { localidadId: localidadId }, '#calle');
        });

        // --- Precarga de selects ---
        const paisSelected = '@Model.PaisId';
        const provinciaSelected = '@Model.ProvinciaId';
        const localidadSelected = '@Model.LocalidadId';
        const calleSelected = '@Model.CalleId';

        function cargarSelectConPromesa(url, parametro, selectDestino) {
            return $.getJSON(url, parametro, function (data) {
                const $select = $(selectDestino);
                $select.empty().append('<option></option>');
                $.each(data, function (i, item) {
                    $select.append(new Option(item.nombre, item.id, false, false));
                });
                $select.prop('disabled', false).trigger('change.select2');
            });
        }

        if (paisSelected) {
            $('#pais').val(paisSelected).trigger('change.select2');
            cargarSelectConPromesa('/Cliente/ObtenerProvincias', { paisId: paisSelected }, '#provincia')
                .then(() => {
                    if (provinciaSelected) {
                        $('#provincia').val(provinciaSelected).trigger('change.select2');
                        return cargarSelectConPromesa('/Cliente/ObtenerLocalidades', { provinciaId: provinciaSelected }, '#localidad');
                    }
                })
                .then(() => {
                    if (localidadSelected) {
                        $('#localidad').val(localidadSelected).trigger('change.select2');
                        return cargarSelectConPromesa('/Cliente/ObtenerCalles', { localidadId: localidadSelected }, '#calle');
                    }
                })
                .then(() => {
                    if (calleSelected) {
                        $('#calle').val(calleSelected).trigger('change.select2');
                    }
                });
        }

        // --- Mostrar/Ocultar contraseña ---
        const passwordInput = document.querySelector("#password");
        const passwordError = document.querySelector("#password-error");
        const togglePassword = document.querySelector(".toggle-password i");

        // Validar mientras escribe (solo si escribe algo)
        passwordInput.addEventListener("input", function () {
            const value = this.value.trim();

            // Misma expresión que el pattern del input
            const regex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[!¡"#$%&\/()=?¿]).{8,}$/;

            if (value.length > 0 && !regex.test(value)) {
                passwordError.classList.remove("d-none");
            } else {
                passwordError.classList.add("d-none");
            }
        });

        // Mostrar/Ocultar contraseña
        $(".toggle-password").on("click", function () {
            const type = passwordInput.getAttribute("type") === "password" ? "text" : "password";
            passwordInput.setAttribute("type", type);
            togglePassword.classList.toggle("fa-eye");
            togglePassword.classList.toggle("fa-eye-slash");
        });

        // Validar al enviar el formulario
        $(".register-form").on("submit", function (e) {
            const value = passwordInput.value.trim();
            const regex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[!¡"#$%&\/()=?¿]).{8,}$/;

            if (value.length > 0 && !regex.test(value)) {
                e.preventDefault();
                passwordError.classList.remove("d-none");
                passwordInput.focus();
            }
        });
    });

    </script>
}
