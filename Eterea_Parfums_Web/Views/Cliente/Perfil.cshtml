@{
    ViewBag.Title = "Perfil";
}

@section Styles {
    <link href="~/Content/StylePerfil.css" rel="stylesheet" type="text/css" />
}


@model Eterea_Parfums_Web.Models.cliente


<div class="register-container">
    <h2 id="title" class="text-center">@ViewBag.Title</h2>
    <hr class="separator">
    <!-- MODIFICAR el class = "perfil-form" cuando este el CSS -->
    @using (Html.BeginForm("Perfil", "Cliente", FormMethod.Post, new { @class = "perfil-form" }))
    {
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label for="nombre">Nombre:</label>
                    @Html.TextBoxFor(m => m.nombre, new { @class = "form-control", required = "required" })
                </div>

                <div class="form-group">
                    <label for="apellido">Apellido:</label>
                    @Html.TextBoxFor(m => m.apellido, new { @class = "form-control", required = "required" })
                </div>

                <div class="form-group">
                    <label for="usuario">Nombre de Usuario:</label>
                    @Html.TextBoxFor(m => m.usuario, new { @class = "form-control", required = "required" })
                    @Html.ValidationMessage("usuario", "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <label for="clave">Contraseña:</label>
                    @Html.PasswordFor(m => m.clave, new { @class = "form-control", placeholder = "Dejar en blanco si no querés cambiarla" })
                </div>

                <div class="form-group">
                    <label for="email">E-mail:</label>
                    @Html.TextBoxFor(m => m.e_mail, new { @class = "form-control", required = "required" })
                    @Html.ValidationMessage("email", "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <label for="dni">DNI:</label>
                    @Html.TextBoxFor(m => m.dni, new { @class = "form-control", required = "required" })
                    @Html.ValidationMessage("dni", "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <label for="fechaNacimiento">Fecha de Nacimiento:</label>
                    <input type="date" class="form-control" name="fecha_nacimiento" value="@Model.fecha_nacimiento.ToString("yyyy-MM-dd")" required />
                    @Html.ValidationMessage("fechadenacimiento", "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <label for="celular">Celular:</label>
                    @Html.TextBoxFor(m => m.celular, new { @class = "form-control", required = "required" })
                    @Html.ValidationMessage("celular", "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group">
                    <label for="pais">País:</label>
                    <select id="pais" name="pais_id" class="form-control" data-selected="@Model.pais_id" required>
                        @foreach (var pais in ViewBag.Paises as List<SelectListItem>)
                        {
                            <option value="@pais.Value" @(pais.Value == Model.pais_id.ToString() ? "selected" : "")>
                                @pais.Text
                            </option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label for="provincia">Provincia:</label>
                    <select id="provincia" name="provincia_id" class="form-control" data-selected="@Model.provincia_id" required>
                        <option value="">Seleccione una provincia</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="localidad">Localidad:</label>
                    <select id="localidad" name="localidad_id" class="form-control" data-selected="@Model.localidad_id" required>
                        <option value="">Seleccione una localidad</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="calle">Calle:</label>
                    <select id="calle" name="calle_id" class="form-control" data-selected="@Model.calle_id" required>
                        <option value="">Seleccione una calle</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="numeracion">Numeración:</label>
                    @Html.TextBoxFor(m => m.numeracion_calle, new { @class = "form-control", required = "required" })
                    @Html.ValidationMessage("numeracion", "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <label for="piso">Piso:</label>
                    @Html.TextBoxFor(m => m.piso, new { @class = "form-control" })
                    @Html.ValidationMessage("piso", "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <label for="departamento">Departamento:</label>
                    @Html.TextBoxFor(m => m.departamento, new { @class = "form-control" })
                    @Html.ValidationMessage("departamento", "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <label for="codigopostal">Código Postal:</label>
                    @Html.TextBoxFor(m => m.codigo_postal, new { @class = "form-control" })
                    @Html.ValidationMessage("codigopostal", "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group">
                <label for="comentarios">Comentario del domicilio:</label>
                @Html.TextAreaFor(m => m.comentarios_domicilio, new { @class = "form-control" })
                @Html.ValidationMessage("comentarios", "", new { @class = "text-danger" })
            </div>
        </div>

        <hr class="separator">

        <button type="submit" class="btn-register">Guardar cambios</button>
    }
</div>

<div style="margin-bottom: 50px;"></div> <!-- Espacio debajo del contenedor -->
