@{
    ViewBag.Title = "Login";
}

@section Styles {
    <link href="~/Content/StyleLogin.css" rel="stylesheet" type="text/css" />
}


<div class="login-wrapper">
    <div class="login-container">

        <!-- Logo -->
        <div class="logo-eterea-container text-center mb-4">
            <img src="@Url.Action("Mostrar", "Imagen", new { nombre = "LogoEterea.png" })" alt="Logo Eterea Parfums" class="logo-eterea" />
        </div>

        <h2>@ViewBag.Title</h2>
        <hr class="separator" />

        <form id="login-form" method="post" action="/Cliente/Login">

            <div class="form-group">
                <label for="usuario">Usuario:</label>
                <input type="text" id="usuario" name="usuario" required />
            </div>

            <div class="form-group">
                <label for="clave">Contraseña:</label>
                <input type="password" id="clave" name="clave" required />
            </div>

            <hr class="separator" />

            <button type="submit" class="btn-login">Iniciar sesión</button>
            <div class="error-message">@ViewData["Error"]</div>
        </form>

        <hr class="separator" />

        <div class="register-message">
            ¿No tienes una cuenta? <a href="/Cliente/Registrar">Regístrate</a>!
        </div>
    </div>
</div>

@if (TempData["ErrorLogin"] != null)
{
    <div class="alert alert-warning text-center mt-3">
        @TempData["ErrorLogin"]
    </div>
}