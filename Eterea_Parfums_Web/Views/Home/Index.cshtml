@model List<Eterea_Parfums_Web.Models.perfume>

@{
    ViewBag.Title = "Home Page";
}

@section Styles {
    <link href="~/Content/StyleHome.css" rel="stylesheet" type="text/css" />
}

<div class="container">

    <!-- Carousel -->
    <div id="myCarousel" class="carousel slide mb-5" data-bs-ride="carousel">
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#myCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#myCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
            <button type="button" data-bs-target="#myCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
        </div>

        <div class="carousel-inner rounded-4 overflow-hidden shadow">
            <div class="carousel-item active">
                <img src="~/Content/Images/descarga2.png" class="d-block w-100" alt="Imagen 1">
            </div>
            <div class="carousel-item">
                <img src="~/Content/Images/descarga1.png" class="d-block w-100" alt="Imagen 2">
            </div>
            <div class="carousel-item">
                <img src="~/Content/Images/descarga3.png" class="d-block w-100" alt="Imagen 3">
            </div>
        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#myCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#myCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
        </button>
    </div>

    <!-- Perfumes -->
    <div class="row">
        @foreach (var perfume in Model)
        {
            <div class="col-md-3 mb-4 d-flex">
                <div class="card w-100" data-id="@perfume.id">
                    <img src="@Url.Content("~/Imagenes/" + perfume.imagen1 + ".jpg")" class="card-img-top custom-img" alt="@perfume.nombre" />
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@perfume.nombre</h5>
                        <p class="card-text mb-1"><strong>Marca:</strong> @perfume.marca.nombre</p>
                        <p class="card-text mb-1"><strong>Precio:</strong> $@perfume.precio_en_pesos</p>
                        <p class="card-text mb-3"><strong>Contenido:</strong> @perfume.presentacion_ml ml</p>

                        <div class="mt-auto d-flex flex-column">
                            <button class="btn-eterea mb-2">
                                <i class="fas fa-eye"></i> Ver
                            </button>
                            <button class="btn-eterea">
                                <i class="fas fa-cart-plus"></i> Agregar al carrito
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Paginación simple -->
    <nav class="mt-5">
        <ul class="pagination justify-content-center">
            <li class="page-item disabled">
                <a class="page-link" href="#">Anterior</a>
            </li>
            <li class="page-item active"><a class="page-link" href="#">1</a></li>
            <li class="page-item"><a class="page-link" href="#">2</a></li>
            <li class="page-item"><a class="page-link" href="#">3</a></li>
            <li class="page-item"><a class="page-link" href="#">Siguiente</a></li>
        </ul>
    </nav>

</div>

<div id="carrito-offcanvas" class="offcanvas-carrito">
    <div class="offcanvas-contenido">
        <h4>🛒 Se agregó a tu carrito</h4>
        <div id="info-perfume-agregado"></div>
        <button onclick="window.location.href='@Url.Action("Index", "Carrito")'" class="btn-eterea mt-3">Ir a mi carrito</button>
    </div>
</div>

@section Scripts {
    <script>
    document.querySelectorAll('.btn-eterea i.fa-cart-plus').forEach(btn => {
        btn.parentElement.addEventListener('click', function () {
            const card = btn.closest('.card');
            const perfumeId = card.getAttribute('data-id');

            fetch('@Url.Action("Agregar", "Carrito")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: `perfumeId=${perfumeId}`
            })
            .then(res => res.json())
            .then(data => {
                // ✅ Redirigir al login si el backend lo indica
                if (data.redirect) {
                    window.location.href = data.redirect;
                    return;
                }

                const contenedor = document.getElementById("info-perfume-agregado");
                contenedor.innerHTML = `
                    <img src="/Imagenes/${data.imagen}.jpg" alt="${data.nombre}" />
                    <p><strong>${data.nombre}</strong></p>
                    <p>${data.tipo} - ${data.presentacion} ml</p>
                    <p>Género: ${data.genero}</p>
                    <p>Precio: ${
                        data.precioDescuento
                             ? `<del>$${data.precioOriginal}</del> <strong>$${data.precioDescuento}</strong>`
                             : `<strong>$${data.precioOriginal}</strong>`
                    }</p>
                    ${data.leyenda ? `<p>${data.leyenda}</p>` : ''}
                `;

                document.getElementById("carrito-offcanvas").classList.add("show");

                setTimeout(() => {
                    document.getElementById("carrito-offcanvas").classList.remove("show");
                }, 6000); // cerrar después de 6 seg
            })
            .catch(err => {
                console.error('Error en la solicitud:', err);
                alert("Hubo un error al intentar agregar el perfume al carrito.");
            });
        });
    });
    </script>
}
