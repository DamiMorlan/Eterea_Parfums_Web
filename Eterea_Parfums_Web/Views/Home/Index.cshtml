@{
    ViewBag.Title = "Home Page";
}

<div class="container">

    <!-- Carousel -->
    <div id="myCarousel" class="carousel slide mb-5" data-bs-ride="carousel">
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#myCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#myCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
            <button type="button" data-bs-target="#myCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
        </div>

        <div class="carousel-inner rounded-4 overflow-hidden shadow">
            <div class="carousel-item active">
                <img src="~/Content/Images/descarga2.png" class="d-block w-100" alt="Imagen 1">
            </div>
            <div class="carousel-item">
                <img src="~/Content/Images/descarga1.png" class="d-block w-100" alt="Imagen 2">
            </div>
            <div class="carousel-item">
                <img src="~/Content/Images/descarga3.png" class="d-block w-100" alt="Imagen 3">
            </div>
        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#myCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#myCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
        </button>
    </div>

    <!-- Perfumes -->
    <div class="row">
        @{
            var perfumes = new[]
            {
                new { Img = "1.jpg", Nombre = "Perfume 1", Marca = "Chanel", Precio = "$12.000", Ml = "100ml" },
                new { Img = "2.jpg", Nombre = "Perfume 2", Marca = "Dior", Precio = "$15.500", Ml = "90ml" },
                new { Img = "3.jpg", Nombre = "Perfume 3", Marca = "Gucci", Precio = "$14.200", Ml = "75ml" },
                new { Img = "4.jpg", Nombre = "Perfume 4", Marca = "Versace", Precio = "$11.800", Ml = "100ml" },
                new { Img = "5.jpg", Nombre = "Perfume 5", Marca = "Carolina Herrera", Precio = "$13.000", Ml = "80ml" },
                new { Img = "6.jpg", Nombre = "Perfume 6", Marca = "Calvin Klein", Precio = "$10.500", Ml = "100ml" },
                new { Img = "7.jpg", Nombre = "Perfume 7", Marca = "Armani", Precio = "$16.000", Ml = "85ml" },
                new { Img = "8.jpg", Nombre = "Perfume 8", Marca = "YSL", Precio = "$17.500", Ml = "90ml" },
            };
        }

        @foreach (var p in perfumes)
        {
            <div class="col-md-3 mb-4 d-flex">
                <div class="card w-100">
                    <img src="~/Content/Images/@p.Img" class="card-img-top custom-img" alt="@p.Nombre" />
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@p.Nombre</h5>
                        <p class="card-text mb-1"><strong>Marca:</strong> @p.Marca</p>
                        <p class="card-text mb-1"><strong>Precio:</strong> @p.Precio</p>
                        <p class="card-text mb-3"><strong>Contenido:</strong> @p.Ml</p>

                        <div class="mt-auto d-flex flex-column">
                            <button class="btn-eterea mb-2">
                                <i class="fas fa-eye"></i> Ver
                            </button>
                            <button class="btn-eterea">
                                <i class="fas fa-cart-plus"></i> Agregar al carrito
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: rgb(249, 230, 225);
    }

    .carousel-inner img {
        height: 400px;
        object-fit: cover;
    }

    .card {
        border: none;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        display: flex;
        flex-direction: column;
    }

        .card:hover {
            box-shadow: 0 12px 24px rgba(0, 0, 0, 0.25);
            transform: translateY(-6px);
        }

    .custom-img {
        height: 250px;
        object-fit: cover;
        width: 100%;
    }

    .card-title {
        font-size: 1.2rem;
        font-weight: bold;
    }

    .card-body {
        background-color: #fff;
        padding: 20px;
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .btn-eterea {
        background-color: rgb(209, 167, 180);
        color: white;
        width: 100%;
        border: none;
        border-radius: 8px;
        padding: 10px;
        font-size: 1rem;
        transition: background-color 0.3s ease, transform 0.2s ease;
    }

        .btn-eterea:hover {
            background-color: rgb(189, 147, 160);
            transform: scale(1.02);
            color: white;
        }
</style>