@model Eterea_Parfums_Web.ViewModels.HomeViewModel

@functions {
    string PrecioFmt(double valor)
    {
        var ci = new System.Globalization.CultureInfo("es-AR");
        bool hasCents = Math.Abs(valor - Math.Truncate(valor)) > 0.000001;
        return valor.ToString(hasCents ? "N2" : "N0", ci);
    }
}

@{
    // Base absoluta/relativa hacia tu API de imágenes
    var API_IMG = Url.Content("~/imagenes/");
}

@{
    ViewBag.Title = "Home Page";
}

@section Styles {
    <link href="~/Content/StyleHome.css" rel="stylesheet" type="text/css" />
}
@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

<div class="container-fluid p-0">

    <!-- Carousel de Imágenes Fijas -->
    @{
        var banners = new List<string>
 {
        "banner1.jpg",
        "banner2.jpg",
        "banner3.jpg",
        "banner4.jpg"
    };
    }

    <div id="myCarousel" class="carousel slide carousel-banners mb-5" data-bs-ride="carousel">
        <div class="carousel-indicators">
            @for (int i = 0; i < banners.Count; i++)
            {
                <button type="button"
                        data-bs-target="#myCarousel"
                        data-bs-slide-to="@i"
                        class="@(i == 0 ? "active" : "")"
                        aria-current="@(i == 0 ? "true" : "false")"
                        aria-label="Slide @(i + 1)">
                </button>
            }
        </div>

        <div class="carousel-inner overflow-hidden shadow">
            @for (int i = 0; i < banners.Count; i++)
            {
                <div class="carousel-item @(i == 0 ? "active" : "")">
                    <img src="@Url.Content("~/Imagenes/" + banners[i])"
                         class="d-block w-100 banner-img"
                         alt="Banner @(i + 1)" />
                </div>
            }
        </div>

        <!-- FLECHA IZQUIERDA -->
        <button class="carousel-control-prev" type="button" data-bs-target="#myCarousel" data-bs-slide="prev">
            <span class="fa-solid fa-chevron-left flecha-carousel-banner"></span>
        </button>

        <!-- FLECHA DERECHA -->
        <button class="carousel-control-next" type="button" data-bs-target="#myCarousel" data-bs-slide="next">
            <span class="fa-solid fa-chevron-right flecha-carousel-banner"></span>
        </button>
    </div>



    @using System.IO

    <!-- Carousel Marcas Perfumes -->
    <div class="bg-marcas py-4 mt-5">

        <h2 class="text-center mb-4 mt-1">Nuestras Marcas</h2>

        <div id="carouselMarcas" class="carousel slide" data-bs-ride="false">
            <div class="carousel-inner">
                @{
                    var itemsPorSlide = 4;
                    int totalItems = Model.Marcas.Count;
                    int totalSlides = (int)Math.Ceiling((double)totalItems / itemsPorSlide);

                    // Ruta física a /Imagenes/
                    var rutaImagenes = Server.MapPath("~/Imagenes");

                    for (int i = 0; i < totalSlides; i++)
                    {
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <div class="row justify-content-center">

                                @for (int j = 0; j < itemsPorSlide && (i * itemsPorSlide + j) < totalItems; j++)
                                {
                                    var marca = Model.Marcas[i * itemsPorSlide + j];

                                    string fileName = marca.Nombre + ".jpg";
                                    string filePath = Path.Combine(rutaImagenes, fileName);

                                    bool existeImagen = System.IO.File.Exists(filePath);

                                    <div class="col-xl-3 col-lg-4 col-sm-6 col-12 mb-4">
                                        <div class="card text-center mb-3 border-0 shadow-sm rounded">
                                            <div class="card-body">

                                                <a href="@Url.Action("Index", "Perfume", new { marcasSeleccionadas = marca.Nombre })"
                                                   class="text-decoration-none"
                                                   style="color: inherit;">

                                                    @if (existeImagen)
                                                    {
                                                        <img src="~/Imagenes/@fileName"
                                                             alt="@marca.Nombre"
                                                             class="img-fluid p-2"
                                                             style="max-height: 80px;" />
                                                    }
                                                    else
                                                    {
                                                        <span style="font-family: 'Georgia', serif; font-size: 1.2rem;">
                                                            @marca.Nombre
                                                        </span>
                                                    }

                                                </a>

                                            </div>
                                        </div>
                                    </div>
                                }

                            </div>
                        </div>
                    }
                }
            </div>

            <!-- FLECHA IZQUIERDA -->
            <button class="carousel-control-prev" type="button" data-bs-target="#carouselMarcas" data-bs-slide="prev">
                <span class="fa-solid fa-chevron-left flecha-carousel"></span>
            </button>

            <!-- FLECHA DERECHA -->
            <button class="carousel-control-next" type="button" data-bs-target="#carouselMarcas" data-bs-slide="next">
                <span class="fa-solid fa-chevron-right flecha-carousel"></span>
            </button>
        </div>

    </div>



    <!-- Carousel Perfumes con Promociones -->
    <div class="bg-marcas py-4 mt-5">
        <h2 class="text-center mb-4 mt-1">Perfumes en Promoción</h2>

        <div id="carouselPerfumesEnPromo" class="carousel slide" data-bs-ride="false">
            <div class="carousel-inner">
                @{
                    var perfumesAgrupados = Model.Perfumes
                        .GroupBy(p => p.Nombre)
                        .Select(g => g.First())
                        .ToList();

                    var itemsPorSlidePromo = 4;
                    var totalItemsPromo = perfumesAgrupados.Count;
                    var totalSlidesPromo = (int)Math.Ceiling((double)totalItemsPromo / itemsPorSlidePromo);



                    for (int i = 0; i < totalSlidesPromo; i++)
                    {
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <div class="row justify-content-center">
                                @for (int j = 0; j < itemsPorSlidePromo && (i * itemsPorSlidePromo + j) < totalItemsPromo; j++)
                                {
                                    var perfume = perfumesAgrupados[i * itemsPorSlidePromo + j];
                                    var presentacionActiva = perfume.Presentaciones.FirstOrDefault(p => p.Ml == perfume.Presentacion) ?? perfume.Presentaciones.First();
                                    var promos = presentacionActiva.Promociones;
                                    var tieneVariasPromos = promos.Count > 1;
                                    var primeraPromo = promos.FirstOrDefault();
                                    var cardId = presentacionActiva.Id;

                                    var prefix = "promo-"; // Prefijo para IDs y data-perfumeid

                                    <div class="col-xl-3 col-lg-4 col-sm-6 col-12 mb-4 d-flex">
                                        <div class="card w-100 perfume-card" id="@($"{prefix}perfume-card-{cardId}")"
                                             data-nombre="@perfume.Nombre"
                                             data-promos='@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(promos))'>

                                            <img src="@($"{API_IMG}{perfume.Imagen}.jpg")"
                                                 class="card-img-top custom-img"
                                                 alt="@perfume.Nombre"
                                                 id="@($"{prefix}imagen-{cardId}")" />

                                            <div class="card-body d-flex flex-column text-center">
                                                <h5 class="card-title">@perfume.Nombre</h5>
                                                <p class="card-text mb-3 marca-text" id="@($"{prefix}marca-{cardId}")">@perfume.Marca</p>

                                                <p class="card-text mb-1"><strong>Tamaño:</strong></p>
                                                <div class="selector-tamanios mt-1 d-flex justify-content-center gap-2" data-id="@perfume.Id">
                                                    @foreach (var p in perfume.Presentaciones)
                                                    {
                                                        var promo = p.Promociones.FirstOrDefault();
                                                        <button type="button"
                                                                class="btn-tamanio btn btn-outline-secondary @(p.Ml == presentacionActiva.Ml ? "active" : "")"
                                                                data-id="@perfume.Id"
                                                                data-perfumeid="@($"{prefix}{p.Id}")"
                                                                data-precio="@p.Precio"
                                                                data-descuento="@(p.Promociones.FirstOrDefault()?.PrecioConDescuento ?? (double?)null)"
                                                                data-tiene-promo="@(p.TienePromocion)"
                                                                data-leyenda="@(p.Promociones.FirstOrDefault()?.LeyendaPromocion ?? "")"
                                                                data-imagen="@($"{API_IMG}{p.Imagen}.jpg")"
                                                                data-marca="@p.Marca"
                                                                data-stock="@p.StockDisponible"
                                                                data-ml="@p.Ml"
                                                                data-promos='@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(p.Promociones))'
                                                                onclick="cambiarPresentacion(this, @perfume.Id)">
                                                            @p.Ml ml
                                                        </button>
                                                    }
                                                </div>

                                                <!-- Carousel Promociones -->
                                                <div class="promo-carousel mt-3" data-perfumeid="@($"{prefix}{cardId}")">
                                                    <div class="promo-display">
                                                        <span class="precio-original" id="@($"{prefix}precio-original-{cardId}")">
                                                            @(primeraPromo != null ? "$" + PrecioFmt(primeraPromo.PrecioOriginal) : "")
