@model Eterea_Parfums_Web.ViewModels.HomeViewModel

@{
    ViewBag.Title = "Home Page";
}

@section Styles {
    <link href="~/Content/StyleHome.css" rel="stylesheet" type="text/css" />
}

<div class="container">

    <div id="myCarousel" class="carousel slide mb-5" data-bs-ride="carousel">
        <div class="carousel-indicators">
            @for (int i = 0; i < Model.Promociones.Count; i++)
            {
                <button type="button"
                        data-bs-target="#myCarousel"
                        data-bs-slide-to="@i"
                        class="@(i == 0 ? "active" : "")"
                        aria-current="@(i == 0 ? "true" : "false")"
                        aria-label="Slide @(i + 1)">
                </button>
            }
        </div>

        <div class="carousel-inner rounded-4 overflow-hidden shadow">
            @for (int i = 0; i < Model.Promociones.Count; i++)
            {
                var promo = Model.Promociones[i];
                <div class="carousel-item @(i == 0 ? "active" : "")">
                    <img src="@Url.Content("~/Imagenes/" + promo.banner + ".jpg" )" class="d-block w-100" alt="@promo.nombre" />
                </div>
            }
        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#myCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#myCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
        </button>
    </div>

    <h2 class="text-center mb-4 mt-5">Nuestras Marcas</h2>

    <div id="carouselMarcas" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
            @{
                var itemsPorSlide = 3;
                int totalItems = Model.Marcas.Count;
                int totalSlides = (int)Math.Ceiling((double)totalItems / itemsPorSlide);
                for (int i = 0; i < totalSlides; i++)
                {
                    <div class="carousel-item @(i == 0 ? "active" : "")">
                        <div class="row justify-content-center">
                            @for (int j = 0; j < itemsPorSlide && (i * itemsPorSlide + j) < totalItems; j++)
                            {
                                var marca = Model.Marcas[i * itemsPorSlide + j];
                                <div class="col-6 col-md-3">
                                    <div class="card text-center mb-3 border-0 shadow-sm rounded">
                                        <div class="card-body">
                                            <h5 class="card-title" style="font-family: 'Georgia', serif;">@marca.Nombre</h5>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#carouselMarcas" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselMarcas" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
        </button>
    </div>

    <h2 class="text-center mb-4 mt-5">Perfumes en Promoción</h2>

    <!-- Perfumes -->
    <div class="row">
        @foreach (var perfume in Model.Perfumes)
        {
            <div class="col-md-3 mb-4 d-flex">
                <div class="card w-100" data-id="@perfume.Id">
                    <img src="@Url.Content("~/Imagenes/" + perfume.Imagen + ".jpg")" class="card-img-top custom-img" alt="@perfume.Nombre" />
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@perfume.Nombre</h5>
                        <p class="card-text mb-1"><strong>Marca:</strong> @perfume.Marca</p>
                        <p class="card-text mb-1"><strong>Precio:</strong> $@perfume.Precio</p>


                        <p class="card-text mb-3"><strong>Contenido:</strong> @perfume.Presentacion ml</p>

                        @if (perfume.StockDisponibleParaWeb == 1)
                        {
                            <p class="text-danger fw-bold">¡Último disponible!</p>
                        }
                        else if (perfume.StockDisponibleParaWeb <= 5)
                        {
                            <p class="text-warning fw-bold">¡Stock limitado!</p>
                        }

                        <div class="mt-auto d-flex flex-column">
                            <button onclick="location.href='@Url.Action("Details", "Perfume", new { id = perfume.Id })'" class="btn-eterea mb-2">
                                <i class="fas fa-eye"></i> Ver
                            </button>

                            <button class="btn-eterea">
                                <i class="fas fa-cart-plus"></i> Agregar al carrito
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>   

</div>

<h2 class="text-center mb-4 mt-5">Más Vendidos</h2>

<div id="carouselMasVendidos" class="carousel slide" data-bs-ride="carousel">
    <div class="carousel-inner">
        @{
            var itemsPorSlideVendidos = 4; // Cantidad de perfumes por slide
            var totalItemsVendidos = Model.MasVendidos.Count;
            var totalSlidesVendidos = (int)Math.Ceiling((double)totalItemsVendidos / itemsPorSlideVendidos);

            for (int i = 0; i < totalSlidesVendidos; i++)
            {
                <div class="carousel-item @(i == 0 ? "active" : "")">
                    <div class="row justify-content-center">
                        @for (int j = 0; j < itemsPorSlideVendidos && (i * itemsPorSlideVendidos + j) < totalItemsVendidos; j++)
                        {
                            var index = i * itemsPorSlideVendidos + j;
                            var perfume = Model.MasVendidos[index];
                            <div class="col-md-3 col-6 mb-4 d-flex">
                                <div class="card w-100" data-id="@perfume.Id">
                                    <img src="@Url.Content("~/Imagenes/" + perfume.Imagen + ".jpg")" class="card-img-top custom-img" alt="@perfume.Nombre" />
                                    <div class="card-body d-flex flex-column text-center">
                                        <h5 class="card-title">@perfume.Nombre</h5>
                                        <p class="card-text mb-1"><strong>Marca:</strong> @perfume.Marca</p>
                                        <p class="card-text mb-1"><strong>Precio:</strong> $@perfume.Precio</p>
                                        <p class="card-text mb-3"><strong>Contenido:</strong> @perfume.Presentacion ml</p>

                                        @if (perfume.StockDisponibleParaWeb == 1)
                                        {
                                            <p class="text-danger fw-bold">¡Último disponible!</p>
                                        }
                                        else if (perfume.StockDisponibleParaWeb <= 5)
                                        {
                                            <p class="text-warning fw-bold">¡Stock limitado!</p>
                                        }

                                        <div class="mt-auto d-flex flex-column">
                                            <button onclick="location.href='@Url.Action("Details", "Perfume", new { id = perfume.Id })'" class="btn-eterea mb-2">
                                                <i class="fas fa-eye"></i> Ver
                                            </button>
                                            <button class="btn-eterea">
                                                <i class="fas fa-cart-plus"></i> Agregar al carrito
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>

    <button class="carousel-control-prev" type="button" data-bs-target="#carouselMasVendidos" data-bs-slide="prev">
        <span class="carousel-control-prev-icon"></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#carouselMasVendidos" data-bs-slide="next">
        <span class="carousel-control-next-icon"></span>
    </button>
</div>




<div id="carrito-offcanvas" class="offcanvas-carrito">
    <div class="offcanvas-contenido">
        <h4>🛒 Se agregó a tu carrito</h4>
        <div id="info-perfume-agregado"></div>
        <button onclick="window.location.href='@Url.Action("Index", "Carrito")'" class="btn-eterea mt-3">Ir a mi carrito</button>
    </div>
</div>

@section Scripts {
    <script>
    document.querySelectorAll('.btn-eterea i.fa-cart-plus').forEach(btn => {
        btn.parentElement.addEventListener('click', function () {
            const card = btn.closest('.card');
            const perfumeId = card.getAttribute('data-id');

            fetch('@Url.Action("Agregar", "Carrito")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: `perfumeId=${perfumeId}`
            })
            .then(res => res.json())
            .then(data => {
                // ✅ Redirigir al login si el backend lo indica
                if (data.redirect) {
                    window.location.href = data.redirect;
                    return;
                }

                if (data.error) {
                    const contenedor = document.getElementById("info-perfume-agregado");
                    contenedor.innerHTML = `
                    <p style="font-weight: bold; color: #c0392b; font-size: 1.1rem;">⚠️ Etérea Parfums</p>
                    <p>${data.error}</p>
                `;

                    document.getElementById("carrito-offcanvas").classList.add("show");

                    setTimeout(() => {
                        document.getElementById("carrito-offcanvas").classList.remove("show");
                    }, 5000);
                    return;
                }


                const contenedor = document.getElementById("info-perfume-agregado");
                contenedor.innerHTML = `
                    <img src="/Imagenes/${data.imagen}.jpg" alt="${data.nombre}" />
                    <p><strong>${data.nombre}</strong></p>
                    <p>${data.tipo} - ${data.presentacion} ml</p>
                    <p>Género: ${data.genero}</p>
                    <p>Precio: ${
                        data.precioDescuento
                             ? `<del>$${data.precioOriginal}</del> <strong>$${data.precioDescuento}</strong>`
                             : `<strong>$${data.precioOriginal}</strong>`
                    }</p>
                    ${data.leyenda ? `<p>${data.leyenda}</p>` : ''}
                `;

                document.getElementById("carrito-offcanvas").classList.add("show");

                setTimeout(() => {
                    document.getElementById("carrito-offcanvas").classList.remove("show");
                }, 6000); // cerrar después de 6 seg
            })
            .catch(err => {
                console.error('Error en la solicitud:', err);
                alert("Hubo un error al intentar agregar el perfume al carrito.");
            });
        });
    });
    </script>
}
