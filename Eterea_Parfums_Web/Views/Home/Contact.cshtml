@{
    ViewBag.Title = "Contacto";
}

@section Styles {
    <link href="~/Content/StyleContacto.css" rel="stylesheet" type="text/css" />
}

<div class="container-fluid">
    <div class="contact-section">
        <!-- Logo -->
        <div class="logo-eterea-container text-center mb-4">
            <img src="~/Imagenes/LogoEterea.png" alt="Logo Eterea Parfums" class="logo-eterea" />
        </div>

        <h2 class="section-title text-center mb-5">@ViewBag.Title</h2>

        <p class="intro-text text-center">
            ¡Nos encantaría saber de ti! Si tienes preguntas, comentarios o necesitas asistencia, no dudes en ponerte en contacto con nosotros.
        </p>

        <!-- Formas de contacto -->
        <div class="contact-box mb-5 text-center">
            <h3 class="titulo-contacto">Formas de Contacto</h3>
            <ul class="contact-list">
                <li>
                    <i class="fas fa-headset me-2"></i>
                    <strong>Asesoramiento:</strong>
                    <a href="mailto:maximiliano.kitagawa@davinci.edu.ar">maximiliano.kitagawa@davinci.edu.ar</a>,
                    <a href="mailto:adrian.campos@davinci.edu.ar">adrian.campos@davinci.edu.ar</a>
                </li>
                <li>
                    <i class="fas fa-tools me-2"></i>
                    <strong>Servicio Técnico:</strong>
                    <a href="mailto:damian.morlan@davinci.edu.ar">damian.morlan@davinci.edu.ar</a>
                </li>
                <li>
                    <i class="fas fa-shopping-bag me-2"></i>
                    <strong>Ventas:</strong>
                    <a href="mailto:marino.serenelli@davinci.edu.ar">marino.serenelli@davinci.edu.ar</a>,
                    <a href="mailto:jose.quispe@davinci.edu.ar">jose.quispe@davinci.edu.ar</a>
                </li>
            </ul>

            <h3 class="mt-4 titulo-contacto">Síguenos</h3>
            <p>Conéctate con nosotros para conocer novedades y promociones:</p>
            <div class="social-icons">
                <a href="https://facebook.com" target="_blank"><i class="fab fa-facebook-f"></i></a>
                <a href="https://instagram.com" target="_blank"><i class="fab fa-instagram"></i></a>
                <a href="https://x.com" target="_blank"><i class="fab fa-x-twitter"></i></a>
                <a href="https://wa.me/" target="_blank"><i class="fab fa-whatsapp"></i></a>
            </div>
        </div>

        <!-- Separador -->
        <hr class="my-5 linea-separadora" />

        <!-- Formulario de contacto -->
        <div class="contact-form-box">
            <h3 class="section-subtitle mb-3" >Formulario de Contacto</h3>
            <form action="/enviarContacto" method="post">
                <div class="form-group">
                    <label for="nombre">Nombre:</label>
                    <input type="text" id="nombre" name="nombre" required>
                </div>
                <div class="form-group">
                    <label for="email">Correo Electrónico:</label>
                    <input type="email" id="email" name="email" required>
                </div>
                <div class="form-group">
                    <label for="mensaje">Mensaje:</label>
                    <textarea id="mensaje" name="mensaje" required></textarea>
                </div>
                <button type="submit"><i class="fas fa-paper-plane"></i> Enviar Mensaje</button>
            </form>
        </div>
    </div>
</div>