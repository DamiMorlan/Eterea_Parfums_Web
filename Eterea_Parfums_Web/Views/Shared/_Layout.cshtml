<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <title>@ViewBag.Title - Eterea Parfums</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />

    <!-- Bootstrap 5 JS + Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <link href="~/Content/StyleLayout.css" rel="stylesheet" type="text/css" />

    @RenderSection("Styles", required: false)
    @Scripts.Render("~/bundles/modernizr")

   
</head>
<body>
    <!-- Navbar con container para ancho centrado -->
    <nav class="navbar navbar-expand-sm navbar-dark custom-navbar fixed-top">
        <div class="container-fluid px-3 px-md-5">
            @Html.ActionLink("Eterea Parfums", "Index", "Home", null, new { @class = "navbar-brand" })

            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                    aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            @{
                var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
            }

            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        @Html.ActionLink("Perfumes", "Index", "Perfume", null,
                            new { @class = "nav-link " + (currentController == "Perfume" ? "active" : "") })
                    </li>
                    <li class="nav-item">
                        @Html.ActionLink("Promociones", "Index", "Promocion", null,
                            new { @class = "nav-link " + (currentController == "Promocion" ? "active" : "") })
                    </li>
                    <li class="nav-item d-sm-none d-md-none d-xl-block">
                        @Html.ActionLink("Blog", "Blog", "Home", null,
                            new { @class = "nav-link " + (currentAction == "Blog" ? "active" : "") })
                    </li>
                    <li class="nav-item d-sm-none d-md-none d-xl-block">
                        @Html.ActionLink("Nosotros", "About", "Home", null,
                            new { @class = "nav-link " + (currentAction == "About" ? "active" : "") })
                    </li>
                    <li class="nav-item d-sm-none d-md-none d-xl-block">
                        @Html.ActionLink("Contacto", "Index", "Contact", null,
                            new { @class = "nav-link " + (currentController == "Contact" ? "active" : "") })
                    </li>
                    <li class="nav-item d-sm-none d-md-none d-xl-block">
                        @Html.ActionLink("Preguntas Frecuentes", "PreguntasFrecuentes", "Home", null,
                                    new { @class = "nav-link " + (currentAction == "PreguntasFrecuentes" ? "active" : "") })
                    </li>
                
                </ul>

                <ul class="navbar-nav">
                    @if (Session["usuarioLogueado"] != null)
                    {
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Carrito")" class="nav-link">
                                <i class="fas fa-shopping-cart"></i> Carrito
                            </a>
                        </li>

                        if (Session["clienteNombre"] != null)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white" href="#" id="usuarioDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-user"></i> @Session["clienteNombre"]
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="usuarioDropdown">
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("VerPerfil", "Cliente")">
                                            <i class="fas fa-id-badge me-2"></i> Mi perfil
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("Index", "Historial")">
                                            <i class="fas fa-shopping-bag me-2"></i> Mis compras
                                        </a>
                                    </li>
                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>
                                    <li>
                                        <a class="dropdown-item text-danger" href="@Url.Action("Logout", "Cliente")">
                                            <i class="fas fa-sign-out-alt me-2"></i> Cerrar sesión
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="nav-item">
                            <a href="@Url.Action("Login", "Cliente")" class="nav-link">
                                <i class="fas fa-user"></i> Iniciar sesión
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Contenido principal sin container, para que la vista decida el ancho -->
    <div class="body-content">
        @RenderBody()
    </div>

    <!-- Footer con container para ancho centrado -->
    <footer class="footer custom-footer">
        <div class="container px-3 px-md-5 py-4">
            <div class="row align-items-center">

                <!-- Columna izquierda: texto -->
                <div class="col-md-4 text-md-start text-center mb-3 mb-md-0">
                    <h5 class="mb-2">Eterea Parfums</h5>
                    <p class="mb-1">&copy; @DateTime.Now.Year - Todos los derechos reservados.</p>
                    <p class="small mb-0">
                        Marcas registradas pertenecen a sus respectivos dueños.<br />
                        Todos los precios incluyen IVA (donde sea aplicable).
                    </p>
                </div>

                <!-- Columna centro: logo centrado -->
                <div class="col-md-4 d-flex justify-content-center">
                    <a href="@Url.Action("Index", "Home")" class="logo-link">
                        <img src="@Url.Content("~/Imagenes/LogoEterea.png")"
                             alt="Logo Eterea Parfums"
                             style="max-height: 100px; max-width: 100%;" />
                    </a>

                </div>

                <!-- Columna derecha: redes sociales -->
                <div class="col-md-4 text-md-end text-center">
                    <div class="d-none d-sm-block d-md-block d-xl-none">
                        <h5 class="mt-2">Mas sobre nosotros</h5>
                        <div class="d-flex flex-column card-subtitle">
                            <a href="@Url.Action("Index", "Contact")" class="links-mas-sobre-nosotros me-0 text-light text-decoration-none">Contacto</a>
                            <a href="@Url.Action("About", "Home")" class="links-mas-sobre-nosotros me-0 text-light text-decoration-none">Nosotros</a>
                            <a href="@Url.Action("PreguntasFrecuentes", "Home")" class="links-mas-sobre-nosotros me-0 text-light text-decoration-none">Preguntas Frecuentes</a>
                            <a href="@Url.Action("Blog", "Home")" class="links-mas-sobre-nosotros me-0 text-light text-decoration-none">Blog</a>

                        </div>
                    </div>
                    <h5 class="mt-2">Sigamos Conectados</h5>
                    <div class="social-icons">
                        <a href="https://www.facebook.com/profile.php?id=61582916420613" target="_blank" class="me-3" aria-label="Facebook"><i class="fab fa-facebook fa-lg"></i></a>
                        <a href="https://www.instagram.com/etereaparfums2024/" target="_blank" class="me-3" aria-label="Instagram"><i class="fab fa-instagram fa-lg"></i></a>
                        <a href="https://x.com/EtereaParfums39" target="_blank" class="me-3" aria-label="X (antes Twitter)"><i class="fab fa-x-twitter fa-lg"></i></a>
                        <a href="https://wa.me/" target="_blank" aria-label="WhatsApp"><i class="fab fa-whatsapp fa-lg"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </footer>


    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/customScripts")
    @RenderSection("scripts", required: false)
    @Scripts.Render("~/bundles/jqueryval")
</body>
</html>
