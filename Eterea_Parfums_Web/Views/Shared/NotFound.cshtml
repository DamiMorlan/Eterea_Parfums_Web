
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "NotFound";
    Response.StatusCode = 404;
}

<style>
    :root {
        --rosa-claro: rgb(235, 199, 206);
        --rosa-medio: rgb(228, 137, 164);
        --rosa-fondo: rgb(249, 230, 225);
        --rosa-profundo: rgb(209, 167, 180);
        --rosa-suave: rgb(250, 236, 239);
        --beige: #f5f5dc;
        --moka: #b89b82;
    }

    body {
        background: var(--rosa-fondo);
    }

    .content-error {
        height: 100%;
        position: relative;
        overflow: hidden;
     
    }

    .content-error .background-image {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: url('@Url.Action("Mostrar", "Imagen", new { nombre = "Error.svg" })') no-repeat center;
        z-index: 0;
    }

    .content-error .content-box {
        z-index: 1;
        max-width: 600px;
    }
</style>

<div class="content-error d-flex justify-content-center align-items-center">
    <div class="background-image"></div>

    <div class="container text-center p-5  rounded  content-box">
        <h1 class="display-4 text-danger fw-bold">¡Vaya!</h1>
        <p class="lead text-secondary mb-4">
            No se ha encontrado ninguna página.<br />Lo sentimos. Sigamos.
        </p>

        <a href="@Url.Action("Index", "Home")" class="btn btn-danger btn-lg">
            Volver al inicio
        </a>
    </div>
</div>

