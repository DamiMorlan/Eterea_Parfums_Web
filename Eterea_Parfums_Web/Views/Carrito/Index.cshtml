@model List<Eterea_Parfums_Web.ViewModels.ItemCarritoViewModel>

@{
    ViewBag.Title = "Carrito";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link href="~/Content/carritoStyle.css" rel="stylesheet" type="text/css" />
}

<div class="carrito-container">

    <h1 class="titulo-carrito">Tu carrito</h1>


    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            <div class="fila-producto">
                <div class="contenedor-producto">
                    <img src="@Url.Content("~/Imagenes/" + item.Imagen + ".jpg")" alt="@item.Nombre" />
                    <div class="producto-detalles">
                        <h3>@item.Nombre</h3>
                        <p>Tipo: @item.TipoDePerfume</p>
                        <p>Presentación: @item.Presentacion ml</p>
                        <p>Género: @item.Genero</p>
                        @if (item.TienePromo)
                        {
                            <p class="precio-original">$@item.PrecioOriginal</p>
                            <p class="precio-descuento">$@item.PrecioConDescuento</p>
                        }
                        else
                        {
                            <p class="precio-descuento">$@item.PrecioOriginal</p>
                        }
                        <label for="cantidad">Cantidad: </label>
                        <select name="cantidad" id="cantidad">
                            @for (int i = 0; i <= 3; i++)
                            {
                                <option value="@i" @(item.Cantidad == i ? "selected" : "")>@i @(i == 0 ? "(Eliminar)" : "")</option>
                            }
                        </select>
                        <div class="producto-precio">
                            <p>Total: $@item.Total</p>
                        </div>
                    </div>
                </div>
                <div class="contenedor-eliminar">
                    🗑️
                </div>
            </div>
        }

        <div class="resumen-carrito">
            @{
                var subtotal = Model.Sum(m => m.PrecioOriginal * m.Cantidad);
                var total = Model.Sum(m => m.Total);
                var descuento = subtotal - total;
            }

            <div>Subtotal (sin descuento): $@subtotal</div>
            <div>Descuentos aplicados: -$@descuento</div>
            <div class="total-final">Total a pagar: $@total</div>

            @if (total >= 10000)
            {
                <div class="envio-gratis">¡Felicidades! Tu envío es gratis</div>
            }

            <button class="btn-finalizar">Finalizar pedido</button>
            <p style="margin-top: 10px; font-size: 0.9rem; color: #555;">
                Los gastos de envío serán calculados al finalizar la compra. Envío gratis en compras mayores a $10.000.
            </p>
        </div>
    }
    else
    {
        <div style="text-align: center; padding: 50px;">
            <div style="font-size: 100px;">🛒</div>
            <h2 style="margin-top: 20px; color: #555;">¡Tu carrito está vacío!</h2>
        </div>
    }
</div>
