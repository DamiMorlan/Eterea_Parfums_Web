@model List<Eterea_Parfums_Web.ViewModels.ItemCarritoViewModel>

@using System.Globalization
@{
    var ciAR = new CultureInfo("es-AR");
}

@{
    var API_IMG = Url.Content("~/imagenes/");
}



@functions {
    // Trunca a 2 decimales SIN redondear (usa decimal para evitar errores binarios de double)
    decimal Trunc2(decimal v) => decimal.Truncate(v * 100m) / 100m;

    // Helper para cuando tenés double:
    decimal Trunc2D(double v) => Trunc2((decimal)v);
}


@if (TempData["ErrorPago"] != null)
{
    <div class="alert alert-danger text-center mt-3">
        @TempData["ErrorPago"]
    </div>
}

@{
    ViewBag.Title = "Carrito";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link href="~/Content/StyleCarrito.css" rel="stylesheet" type="text/css" />
}

<div class="carrito-container">

    <h1 class="titulo-carrito">Tu carrito</h1>

    @if (ViewBag.MensajeStockActualizado != null)
    {
        <div class="alert alert-warning text-center mt-3">
            @ViewBag.MensajeStockActualizado
        </div>
    }

    @if (Model != null && Model.Any())
    {

        foreach (var item in Model)
        {
            <div class="fila-producto" id="perfume-@item.PerfumeId">
                <div class="contenedor-producto">
                    <a href="@Url.Action("Details", "Perfume", new { id = item.PerfumeId })">


                        <img src="@($"{API_IMG}{item.Imagen}.jpg")"
                             alt="@item.Nombre"
                             class="img-perfume" />

                    </a>
                    <div class="producto-detalles">
                        <h3>@item.Nombre</h3>
                        <p>Tipo: @item.TipoDePerfume</p>
                        <p>Presentación: @item.Presentacion ml</p>
                        <p>Género: @item.Genero</p>

                        @if (item.StockDisponibleParaVentaWeb == 1)
                        {
                            <p style="color: red; font-weight: bold;">¡Último disponible!</p>
                        }
                        @if (item.MostrarPrecioTachado && item.PrecioConDescuento.HasValue)
                        {
                            <p class="precio-original" style="text-decoration: line-through; color: gray;">
                                $ @item.PrecioOriginal.ToString("N2", ciAR)
                            </p>
                            <p class="precio-descuento" style="color: #cc6699; font-weight: bold;">
                                $@item.PrecioConDescuento.Value.ToString("N2", ciAR)
                            </p>
                        }
                        else
                        {
                            <p class="precio-descuento" style="color: black;">
                                $@item.PrecioOriginal.ToString("N2", ciAR)
                            </p>
                        }

                        @if (!string.IsNullOrWhiteSpace(item.LeyendaPromo))
                        {
                            <p class="leyenda-promo">@Html.Raw(item.LeyendaPromo)</p>
                        }

                        <label for="cantidad-@item.PerfumeId">Cantidad: </label>
                        <select id="cantidad-@item.PerfumeId" data-id="@item.PerfumeId" onchange="actualizarCantidad(this)">
                            @for (int i = 0; i <= item.StockDisponibleParaVentaWeb; i++)
                            {
                                <option value="@i" @(item.Cantidad == i ? "selected" : "")>@i @(i == 0 ? "(Eliminar)" : "")</option>
                            }
                        </select>


                        <div class="producto-precio">
                            <p id="total-perfume-@item.PerfumeId" class="total-perfume">Total: $@item.Total.ToString("N2")</p>
                        </div>
                    </div>
                </div>
                <div class="contenedor-eliminar">
                    <button type="button"
                            onclick="eliminarPerfume(@item.PerfumeId); return false;"
                            style="background:none; border:none; cursor:pointer;" title="Eliminar">
                        🗑️
                    </button>

                </div>
            </div>
        }

<div class="resumen-carrito">
    @{
        // Pase todo a decimal durante el cálculo
        decimal subtotalRaw = Model.Sum(m => (decimal)m.PrecioOriginal * m.Cantidad);
        decimal totalRaw = Model.Sum(m => (decimal)m.Total);
        decimal descuentoRaw = subtotalRaw - totalRaw;

        // Truncar a 2 decimales SIN redondear para mostrar
        var subtotal = Trunc2(subtotalRaw);
        var total = Trunc2(totalRaw);
        var descuento = Trunc2(descuentoRaw);
    }

    <div class="fila-resumen">
        <span class="etiqueta">Subtotal (sin descuento):</span>
        <span class="valor" id="subtotal">$@subtotal.ToString("N2", ciAR)</span>
    </div>
    <div class="fila-resumen">
        <span class="etiqueta">Descuentos aplicados:</span>
        <span class="valor descuento" id="descuento">-$@descuento.ToString("N2", ciAR)</span>
    </div>
    <div class="fila-resumen total">
        <span class="etiqueta">Total a pagar:</span>
        <span class="valor" id="total">$@total.ToString("N2", ciAR)</span>
    </div>

    <div id="envioGratisMensaje"
         class="mt-2 text-center"
         style="color: var(--bordo); font-weight: bold; @(total >= 70000 ? "" : "display:none;")">
        ¡Felicidades! Tu envío es gratis
    </div>

    @if (total < 70000)
    {
        <p style="margin-top: 10px; font-size: 0.9rem; color: #555; text-align: center;">
            Los gastos de envío serán calculados al finalizar la compra. Envío gratis en compras mayores a $70.000.
        </p>
    }

    @using (Html.BeginForm("VistaPrevia", "Pedido", FormMethod.Get))
    {
        <div class="contenedor-boton-finalizar text-center mt-3">
            <button type="submit" class="btn btn-de-finalizar btn-lg">Finalizar pedido</button>
        </div>
    }


</div>

    }
    else
    {
        <div style="text-align: center; padding: 50px;">
            <div style="font-size: 100px;">🛒</div>
            <h2 style="margin-top: 20px; color: #555;">¡Tu carrito está vacío!</h2>
        </div>
    }
</div>

@section Scripts {
    <script>
        function actualizarCantidad(select) {
            const perfumeId = select.dataset.id;
            const cantidad = select.value;

            console.log("Cambiando cantidad:", perfumeId, cantidad); // DEBUG

            const resumen = document.querySelector('.resumen-carrito');
            resumen.style.opacity = "0.5";

            const urlActualizar = '@Url.Action("ActualizarCantidad", "Carrito")';

            fetch(urlActualizar, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: `perfumeId=${perfumeId}&cantidad=${cantidad}`
            })
            .then(response => {
                if (!response.ok) throw new Error("Error de red");
                return response.json();
            })
                .then(data => {
                    if (data.success) {
                        // ✅ Pintar totales SIEMPRE (aunque se elimine)
                        pintarTotales(data);

                        // ✅ Si se eliminó el ítem (cantidad = 0)
                        if (data.eliminado === true || cantidad === "0") {
                            const fila = document.getElementById(`perfume-${perfumeId}`);
                            if (fila) {
                                fila.classList.add("fade-out");
                                setTimeout(() => {
                                    fila.remove();

                                    // Restaurar opacidad
                                    resumen.style.opacity = "1";

                                    // Si ya no hay perfumes, mostrar mensaje de carrito vacío
                                    if (document.querySelectorAll('.fila-producto').length === 0) {
                                        document.querySelector('.carrito-container').innerHTML = `
                            <div style="text-align: center; padding: 50px;">
                                <div style="font-size: 100px;">🛒</div>
                                <h2 style="margin-top: 20px; color: #555;">¡Tu carrito está vacío!</h2>
                            </div>`;
                                    }
                                }, 500);
                            }
                        } else {
                            // ✅ Reemplazo de fila cuando NO se elimina
                            const fila = document.getElementById(`perfume-${data.perfumeId}`);
                            if (fila && data.filaHtml) {
                                const nuevoDiv = document.createElement("div");
                                nuevoDiv.innerHTML = data.filaHtml;
                                const nuevaFila = nuevoDiv.firstElementChild;
                                fila.replaceWith(nuevaFila);
                            }
                            resumen.style.opacity = "1";
                        }
                    } else {
                        console.warn("Respuesta sin éxito:", data);
                        alert("No se pudo actualizar el carrito.");
                        resumen.style.opacity = "1";
                    }
                })
                .catch(err => {
                    console.error("Error en actualizarCantidad:", err);
                    resumen.style.opacity = "1";
                    alert("Ocurrió un error al actualizar el carrito.");
                });
        }

       function eliminarPerfume(perfumeId) {
    const resumen = document.querySelector('.resumen-carrito');
    const fila = document.getElementById(`perfume-${perfumeId}`);  // ✅ definir la fila
    if (resumen) resumen.style.opacity = "0.5";

    fetch('@Url.Action("EliminarPerfume", "Carrito")', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded'
            // Si tu acción usa [ValidateAntiForgeryToken], descomenta la línea de abajo
            // 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
        },
        body: `perfumeId=${encodeURIComponent(perfumeId)}`
    })
    .then(res => {
        if (!res.ok) throw new Error('Error de red');
        return res.json();
    })
    .then(data => {
        if (!data || data.success !== true) {
            throw new Error(data && data.message ? data.message : 'No se pudo eliminar el producto.');
        }

        // ✅ Actualizar totales UNA sola vez
        pintarTotales(data);

        // ✅ Animación + quitar fila
        if (fila) {
            fila.classList.add('fade-out');
            setTimeout(() => {
                fila.remove();

                // Si ya no quedan productos, mostrar “carrito vacío”
                if (document.querySelectorAll('.fila-producto').length === 0) {
                    document.querySelector('.carrito-container').innerHTML = `
                        <div style="text-align: center; padding: 50px;">
                            <div style="font-size: 100px;">🛒</div>
                            <h2 style="margin-top: 20px; color: #555;">¡Tu carrito está vacío!</h2>
                        </div>`;
                }

                if (resumen) resumen.style.opacity = "1";
            }, 400);
        } else {
            // Si por algún motivo no encontramos la fila, al menos restauramos la UI
            if (resumen) resumen.style.opacity = "1";
        }
    })
    .catch(err => {
        console.error('Error al eliminar:', err);
        if (resumen) resumen.style.opacity = "1";
        alert('Ocurrió un error al eliminar el perfume.');
    });
}


        // Formateador ARS (no redondea porque ya le pasamos truncado)




        const fmtARNumber = new Intl.NumberFormat('es-AR', {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        });

        function desdeCentavos(cents) {
            if (!cents) return 0;
            return cents / 100.0;
        }



        function pintarTotales(data) {
            const sub = desdeCentavos(data.subtotal_cents);
            const des = desdeCentavos(data.descuento_cents);
            const tot = desdeCentavos(data.total_cents);

            const elSub = document.getElementById("subtotal");
            const elDes = document.getElementById("descuento");
            const elTot = document.getElementById("total");

            if (elSub) elSub.textContent = '$ ' + fmtARNumber.format(sub);
            if (elDes) elDes.textContent = '- $ ' + fmtARNumber.format(des);
            if (elTot) elTot.textContent = '$ ' + fmtARNumber.format(tot);

            // Mostrar / ocultar mensaje de envío gratis
            const aviso = document.getElementById('envioGratisMensaje');

            if (aviso) {
                if (data.total_cents >= 70000 * 100) { // 70.000 en centavos
                    aviso.style.display = 'block';
                } else {
                    aviso.style.display = 'none';
                }
            }
        }

    </script>
}





