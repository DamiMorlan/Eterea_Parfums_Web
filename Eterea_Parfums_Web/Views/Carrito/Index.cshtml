@model List<Eterea_Parfums_Web.ViewModels.ItemCarritoViewModel>


@if (TempData["ErrorPago"] != null)
{
    <div class="alert alert-danger text-center mt-3">
        @TempData["ErrorPago"]
    </div>
}

@{
    ViewBag.Title = "Carrito";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link href="~/Content/StyleCarrito.css" rel="stylesheet" type="text/css" />
}

<div class="carrito-container">

    <h1 class="titulo-carrito">Tu carrito</h1>

    @if (ViewBag.MensajeStockActualizado != null)
    {
        <div class="alert alert-warning text-center mt-3">
            @ViewBag.MensajeStockActualizado
        </div>
    }

    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            <div class="fila-producto" id="perfume-@item.PerfumeId">
                <div class="contenedor-producto">
                    <a href="@Url.Action("Details", "Perfume", new { id = item.PerfumeId })">
                        <img src="@Url.Content("~/Imagenes/" + item.Imagen + ".jpg")" alt="@item.Nombre" />
                    </a>
                    <div class="producto-detalles">
                        <h3>@item.Nombre</h3>
                        <p>Tipo: @item.TipoDePerfume</p>
                        <p>Presentación: @item.Presentacion ml</p>
                        <p>Género: @item.Genero</p>

                        @if (item.StockDisponibleParaVentaWeb == 1)
                        {
                            <p style="color: red; font-weight: bold;">¡Último disponible!</p>
                        }

                        @if (item.TienePromo && item.PrecioOriginal != item.PrecioConDescuento)
                        {
                            <p class="precio-original" style="text-decoration: line-through; color: gray;">
                                $@item.PrecioOriginal.ToString("N0")
                            </p>
                            <p class="precio-descuento">$@item.PrecioConDescuento.ToString("N0")</p>
                        }
                        else
                        {
                            <p class="precio-descuento">$@item.PrecioOriginal.ToString("N0")</p>
                        }

                        @if (!string.IsNullOrWhiteSpace(item.LeyendaPromo))
                        {
                            <p class="leyenda-promo">@Html.Raw(item.LeyendaPromo)</p>
                        }


                        else
                        {
                            <p class="precio-descuento">$@item.PrecioOriginal.ToString("N0")</p>
                        }

                        <label for="cantidad-@item.PerfumeId">Cantidad: </label>
                        <select id="cantidad-@item.PerfumeId" data-id="@item.PerfumeId" onchange="actualizarCantidad(this)">
                            @for (int i = 0; i <= item.StockDisponibleParaVentaWeb; i++)
                            {
                                <option value="@i" @(item.Cantidad == i ? "selected" : "")>@i @(i == 0 ? "(Eliminar)" : "")</option>
                            }
                        </select>


                        <div class="producto-precio">
                            <p id="total-perfume-@item.PerfumeId">Total: $@item.Total.ToString("N0")</p>
                        </div>
                    </div>
                </div>
                <div class="contenedor-eliminar">
                    <form action="@Url.Action("Eliminar", "Carrito")" method="post" style="display:inline;">
                        <input type="hidden" name="perfumeId" value="@item.PerfumeId" />
                        <button type="submit" style="background:none; border:none; cursor:pointer;" title="Eliminar">
                            🗑️
                        </button>
                    </form>
                </div>
            </div>
        }

        <div class="resumen-carrito">
            @{
                var subtotal = Model.Sum(m => m.PrecioOriginal * m.Cantidad);
                var total = Model.Sum(m => m.Total);
                var descuento = subtotal - total;
            }

            <div class="fila-resumen">
                <span class="etiqueta">Subtotal (sin descuento):</span>
                <span class="valor" id="subtotal">$@subtotal.ToString("N0")</span>
            </div>
            <div class="fila-resumen">
                <span class="etiqueta">Descuentos aplicados:</span>
                <span class="valor descuento" id="descuento">-$@descuento.ToString("N0")</span>
            </div>
            <div class="fila-resumen total">
                <span class="etiqueta">Total a pagar:</span>
                <span class="valor" id="total">$@total.ToString("N0")</span>
            </div>

            @if (total >= 50000)
            {
                <div class="envio-gratis">¡Felicidades! Tu envío es gratis</div>
            }
            else
            {
                <p style="margin-top: 10px; font-size: 0.9rem; color: #555; text-align: center;">
                    Los gastos de envío serán calculados al finalizar la compra. Envío gratis en compras mayores a $50.000.
                </p>
            }

            @using (Html.BeginForm("VistaPrevia", "Pedido", FormMethod.Post))
            {
                foreach (var item in Model)
                {
                    <input type="hidden" name="PerfumeIds" value="@item.PerfumeId" />
                    <input type="hidden" name="Cantidades" value="@item.Cantidad" />
                    <input type="hidden" name="Subtotal" value="@subtotal" />
                    <input type="hidden" name="Descuento" value="@descuento" />
                    <input type="hidden" name="Total" value="@total" />

                }

                <div class="contenedor-boton-finalizar text-center mt-3">
                    <button type="submit" class="btn btn-success btn-lg">Finalizar pedido</button>
                </div>
            }

        </div>

    }
    else
    {
        <div style="text-align: center; padding: 50px;">
            <div style="font-size: 100px;">🛒</div>
            <h2 style="margin-top: 20px; color: #555;">¡Tu carrito está vacío!</h2>
        </div>
    }
</div>

@section Scripts {
    <script>
        function actualizarCantidad(select) {
    const perfumeId = select.dataset.id;
    const cantidad = select.value;

    const resumen = document.querySelector('.resumen-carrito');
    resumen.style.opacity = "0.5";

    fetch('@Url.Action("ActualizarCantidad", "Carrito")', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded'
        },
        body: `perfumeId=${perfumeId}&cantidad=${cantidad}`
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            if (cantidad === "0") {
                const fila = document.getElementById(`perfume-${perfumeId}`);
                if (fila) {
                    fila.classList.add("fade-out");
                    setTimeout(() => {
                        fila.remove();

                        if (document.querySelectorAll('.fila-producto').length === 0) {
                            document.querySelector('.carrito-container').innerHTML = `
                                <div style="text-align: center; padding: 50px;">
                                    <div style="font-size: 100px;">🛒</div>
                                    <h2 style="margin-top: 20px; color: #555;">¡Tu carrito está vacío!</h2>
                                </div>`;
                        }
                    }, 500);
                }
                return;
            }

            // ✅ Actualizar texto totales

            document.getElementById("subtotal").textContent = `$${data.subtotal}`;
            document.getElementById("descuento").textContent = `-$${data.descuento}`;
            document.getElementById("total").textContent = `$${data.total}`;

            // ✅ Actualizar total del perfume individual
            const totalElemento = document.getElementById(`total-perfume-${data.perfumeId}`);
            if (totalElemento) {
                totalElemento.innerText = `Total: $${data.perfumeTotal}`;
                totalElemento.style.transition = "background-color 0.3s";
                totalElemento.style.backgroundColor = "#ffffcc";
                setTimeout(() => {
                    totalElemento.style.backgroundColor = "transparent";
                }, 500);
            }

            // ✅ Actualizar leyenda y precios
            const productoDiv = document.getElementById(`perfume-${data.perfumeId}`);
            if (productoDiv) {
                const precioOriginalEl = productoDiv.querySelector(".precio-original");
                const precioDescuentoEl = productoDiv.querySelector(".precio-descuento");
                const leyendaEl = productoDiv.querySelector(".leyenda-promo");

                if (data.mostrarPrecioTachado === true) {
                    // Mostrar precio original tachado y precio con descuento
                    if (precioOriginalEl) {
                        precioOriginalEl.textContent = `$${data.precioOriginal}`;
                        precioOriginalEl.style.display = "block";
                    }
                    if (precioDescuentoEl) {
                        precioDescuentoEl.textContent = `$${data.precioConDescuento}`;
                    }
                } else {
                    // Ocultar precio tachado, mostrar solo el precio original
                    if (precioOriginalEl) {
                        precioOriginalEl.style.display = "none";
                    }
                    if (precioDescuentoEl) {
                        precioDescuentoEl.textContent = `$${data.precioOriginal}`;
                    }
                }


                if (leyendaEl) {
                    leyendaEl.innerHTML = data.leyendaPromo || "";
                }
            }
        }

        resumen.style.opacity = "1";
    })
    .catch(() => {
        resumen.style.opacity = "1";
        alert("Error al actualizar el carrito");
    });
}

    </script>
}



